{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.com/schemas/donutProgressChartSchema.json",
  "title": "Donut Progress Chart Configuration",
  "description": "Schema for configuring a donut progress chart.",
  "type": "object",
  "properties": {
    "data": {
      "$ref": "commonChartDefinitions.json#/definitions/chartDataArray"
    },
    "pipe": {
      "type": "string",
      "default": "key_value",
      "description": "数据处理方式，例如 \"key_value\""
    },
    "props": {
      "type": "object",
      "description": "图表的配置项",
      "properties": {
        "type": {
          "type": "string",
          "const": "donut-progress",
          "description": "图表类型固定为圆环进度图"
        },
        "title": {
          "$ref": "commonChartDefinitions.json#/definitions/titleConfig"
        },
        "background": {
          "$ref": "commonChartDefinitions.json#/definitions/backgroundConfig"
        },
        "map": {
          "type": "array",
          "description": "数据映射配置 (通常两项: 名称和进度值)",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "description": "映射名称, e.g., '名称' or '值'"
              },
              "index": {
                "type": "number",
                "description": "数据列索引"
              },
              "isLegend": {
                "type": "boolean",
                "default": false,
                "description": "此列是否作为图例 (usually false for progress)"
              },
              "function": {
                "type": "string",
                "description": "映射函数类型 (e.g., 'objCol' for name, 'vCol' for value)"
              },
              "configurable": {
                "type": "boolean",
                "description": "图表是否绘制这一列数值"
              },
              "type": {
                "type": "string",
                "description": "图表中绘制的元素类型 (progress arc)",
                "enum": [
                  "pie"
                ]
              }
            },
            "required": [
              "name",
              "index",
              "isLegend",
              "function",
              "configurable",
              "type"
            ]
          },
          "minItems": 2,
          "maxItems": 2
        },
        "fill": {
          "type": "object",
          "description": "进度条颜色配置",
          "properties": {
            "controlType": {
              "type": "string",
              "const": "single",
              "description": "填充控制类型，只能是单色"
            },
            "props": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "color": {
                    "$ref": "commonChartDefinitions.json#/definitions/colorOption"
                  },
                  "shadow": {
                    "type": "object",
                    "properties": {
                      "show": {
                        "type": "boolean",
                        "default": false
                      },
                      "type": {
                        "type": "string",
                        "enum": [
                          "outer",
                          "inner"
                        ],
                        "default": "outer"
                      },
                      "angle": {
                        "type": "number",
                        "default": 45
                      },
                      "blur": {
                        "type": "number",
                        "default": 3
                      },
                      "color": {
                        "$ref": "commonChartDefinitions.json#/definitions/simpleColor",
                        "default": {
                          "color": "#000000",
                          "opacity": 0.2
                        }
                      },
                      "radius": {
                        "type": "number",
                        "default": 2
                      }
                    }
                  },
                  "border": {
                    "type": "object",
                    "properties": {
                      "type": {
                        "type": "string",
                        "enum": [
                          "solid",
                          "dashed",
                          "dotted"
                        ],
                        "default": "solid"
                      },
                      "width": {
                        "type": "number",
                        "default": 0
                      },
                      "color": {
                        "$ref": "commonChartDefinitions.json#/definitions/borderElementColorOption"
                      }
                    }
                  }
                },
                "required": [
                  "color",
                  "shadow",
                  "border"
                ]
              },
              "minItems": 1,
              "maxItems": 1
            }
          },
          "required": [
            "controlType",
            "props"
          ]
        },
        "display": {
          "type": "object",
          "description": "显示配置，定义圆环进度图的显示属性",
          "properties": {
            "pie": {
              "type": "object",
              "description": "圆环进度图特定显示属性",
              "properties": {
                "innerRadiusRatio": {
                  "type": "number",
                  "default": 0.7,
                  "minimum": 0,
                  "maximum": 0.99,
                  "description": "进度图整体内径占比 (creating the donut)"
                },
                "gapPercentage": {
                  "type": "number",
                  "default": 0,
                  "minimum": 0,
                  "maximum": 100,
                  "description": "圆环间隙 (usually 0 for a single progress)"
                },
                "startAngle": {
                  "type": "number",
                  "enum": [
                    0,
                    90,
                    180,
                    270
                  ],
                  "default": 90,
                  "description": "圆环绘制起始角度"
                },
                "rotateDirection": {
                  "type": "string",
                  "enum": [
                    "clockwise",
                    "counterclockwise"
                  ],
                  "default": "clockwise",
                  "description": "按顺时针绘制或者逆时针绘制"
                },
                "backgroundColor": {
                  "description": "圆环底部背景 (轨道) 颜色",
                  "oneOf": [
                    {
                      "$ref": "commonChartDefinitions.json#/definitions/simpleColor"
                    },
                    {
                      "$ref": "commonChartDefinitions.json#/definitions/gradientColor"
                    },
                    {
                      "type": "null",
                      "description": "null表示自动色，即与上层圆环填充色相同 (or a default track color)"
                    }
                  ],
                  "default": {
                    "color": "#E0E0E0",
                    "opacity": 1
                  }
                },
                "border": {
                  "type": "object",
                  "properties": {
                    "radius": {
                      "type": "number",
                      "default": 0,
                      "description": "边框圆角 (arc ends rounding)"
                    },
                    "type": {
                      "type": "string",
                      "enum": [
                        "solid",
                        "dashed",
                        "dotted"
                      ],
                      "default": "solid"
                    },
                    "width": {
                      "type": "number",
                      "default": 0
                    },
                    "color": {
                      "$ref": "commonChartDefinitions.json#/definitions/borderElementColorOption"
                    }
                  },
                  "required": [
                    "radius",
                    "type",
                    "width"
                  ]
                }
              },
              "required": [
                "innerRadiusRatio",
                "gapPercentage",
                "startAngle",
                "rotateDirection",
                "backgroundColor",
                "border"
              ]
            }
          },
          "required": [
            "pie"
          ]
        },
        "legend": {
          "$ref": "commonChartDefinitions.json#/definitions/legendConfig"
        },
        "label": {
          "type": "object",
          "description": "标签配置 (通常显示在圆环中心)",
          "properties": {
            "show": {
              "type": "boolean",
              "default": true,
              "description": "是否显示所有标签（总开关）"
            },
            "textLabel": {
              "type": "object",
              "description": "文字标签 (e.g., '开发进度')",
              "properties": {
                "show": {
                  "type": "boolean",
                  "default": true
                },
                "fontFamily": {
                  "type": "string",
                  "default": "Misans 常规"
                },
                "fontSize": {
                  "type": "number",
                  "default": 16
                },
                "color": {
                  "$ref": "commonChartDefinitions.json#/definitions/simpleColor",
                  "default": {
                    "color": "#333333",
                    "opacity": 1
                  }
                }
              },
              "required": [
                "show",
                "fontFamily",
                "fontSize",
                "color"
              ]
            },
            "numberLabel": {
              "type": "object",
              "description": "数值标签 (e.g., '70%')",
              "properties": {
                "show": {
                  "type": "boolean",
                  "default": true
                },
                "fontFamily": {
                  "type": "string",
                  "default": "Misans 常规"
                },
                "fontSize": {
                  "type": "number",
                  "default": 24
                },
                "color": {
                  "$ref": "commonChartDefinitions.json#/definitions/simpleColor",
                  "default": {
                    "color": "#000000",
                    "opacity": 1
                  }
                }
              },
              "required": [
                "show",
                "fontFamily",
                "fontSize",
                "color"
              ]
            },
            "highlight": {
              "type": "boolean",
              "default": false
            },
            "overlap": {
              "type": "boolean",
              "default": false
            }
          },
          "required": [
            "show",
            "textLabel",
            "numberLabel",
            "highlight",
            "overlap"
          ]
        },
        "numberFormat": {
          "$ref": "commonChartDefinitions.json#/definitions/numberFormatConfig"
        },
        "animation": {
          "$ref": "commonChartDefinitions.json#/definitions/animationConfig"
        },
        "tooltip": {
          "$ref": "commonChartDefinitions.json#/definitions/tooltipConfig"
        },
        "padding": {
          "$ref": "commonChartDefinitions.json#/definitions/paddingConfig"
        }
      },
      "required": [
        "type",
        "title",
        "background",
        "map",
        "fill",
        "display",
        "legend",
        "label",
        "numberFormat",
        "animation",
        "tooltip",
        "padding"
      ]
    }
  },
  "required": [
    "data",
    "pipe",
    "props"
  ]
}