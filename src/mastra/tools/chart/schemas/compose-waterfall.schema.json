{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.com/schemas/compositionWaterfallChartSchema.json",
  "title": "Composition Waterfall Chart Configuration",
  "description": "Schema for configuring a composition waterfall chart, with fully inlined axis configurations.",
  "type": "object",
  "properties": {
    "data": {
      "$ref": "commonChartDefinitions.json#/definitions/chartDataArray"
    },
    "pipe": {
      "type": "string",
      "default": "key_value",
      "description": "数据处理方式，例如 \"key_value\""
    },
    "props": {
      "type": "object",
      "description": "图表的配置项",
      "properties": {
        "type": {
          "type": "string",
          "const": "compose-waterfall",
          "description": "图表类型固定为组成瀑布图"
        },
        "title": {
          "$ref": "commonChartDefinitions.json#/definitions/titleConfig"
        },
        "background": {
          "$ref": "commonChartDefinitions.json#/definitions/backgroundConfig"
        },
        "map": {
          "type": "array",
          "description": "数据映射配置 (Category/Stage and Value)",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "description": "映射名称, e.g., '名称' or '值'"
              },
              "index": {
                "type": "number",
                "description": "数据列索引"
              },
              "isLegend": {
                "type": "boolean",
                "default": false,
                "description": "第一列是否作为图例，其他列默认为false"
              },
              "function": {
                "type": "string",
                "description": "映射函数类型 (e.g., 'objCol' for category, 'vCol' for value)"
              },
              "configurable": {
                "type": "boolean",
                "description": "图表是否绘制这一列数值"
              },
              "xAxisIndex": {
                "type": "number",
                "default": 0
              },
              "yAxisIndex": {
                "type": "number",
                "default": 0
              },
              "type": {
                "type": "string",
                "description": "图表中绘制的元素类型",
                "enum": [
                  "bar"
                ]
              }
            },
            "required": [
              "name",
              "index",
              "isLegend",
              "function",
              "configurable",
              "type"
            ],
            "oneOf": [
              {
                "description": "Must have xAxisIndex and not yAxisIndex.",
                "required": [
                  "xAxisIndex"
                ],
                "properties": {
                  "yAxisIndex": false
                }
              },
              {
                "description": "Must have yAxisIndex and not xAxisIndex.",
                "required": [
                  "yAxisIndex"
                ],
                "properties": {
                  "xAxisIndex": false
                }
              }
            ]
          },
          "minItems": 2,
          "maxItems": 2
        },
        "fill": {
          "type": "object",
          "description": "柱体颜色配置 (often distinct colors for increase, decrease, total)",
          "properties": {
            "controlType": {
              "type": "string",
              "enum": [
                "single",
                "multiple",
                "gradient"
              ],
              "default": "multiple"
            },
            "props": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "color": {
                    "$ref": "commonChartDefinitions.json#/definitions/colorOption"
                  },
                  "shadow": {
                    "type": "object",
                    "properties": {
                      "show": {
                        "type": "boolean",
                        "default": false
                      },
                      "type": {
                        "type": "string",
                        "enum": [
                          "outer",
                          "inner"
                        ],
                        "default": "outer"
                      },
                      "angle": {
                        "type": "number",
                        "default": 45
                      },
                      "blur": {
                        "type": "number",
                        "default": 3
                      },
                      "color": {
                        "$ref": "commonChartDefinitions.json#/definitions/simpleColor",
                        "default": {
                          "color": "#000000",
                          "opacity": 0.2
                        }
                      },
                      "radius": {
                        "type": "number",
                        "default": 2
                      }
                    }
                  },
                  "border": {
                    "type": "object",
                    "properties": {
                      "type": {
                        "type": "string",
                        "enum": [
                          "solid",
                          "dashed",
                          "dotted"
                        ],
                        "default": "solid"
                      },
                      "width": {
                        "type": "number",
                        "default": 0
                      },
                      "color": {
                        "$ref": "commonChartDefinitions.json#/definitions/borderElementColorOption"
                      }
                    }
                  }
                },
                "required": [
                  "color",
                  "shadow",
                  "border"
                ]
              }
            }
          },
          "required": [
            "controlType",
            "props"
          ]
        },
        "display": {
          "type": "object",
          "description": "显示配置，定义瀑布图柱体的显示属性",
          "properties": {
            "bar": {
              "type": "object",
              "description": "瀑布图柱体显示属性",
              "properties": {
                "widthPercent": {
                  "type": "number",
                  "default": 0.7,
                  "minimum": 0.01,
                  "maximum": 1,
                  "description": "柱状图宽度占比"
                },
                "order": {
                  "type": "string",
                  "enum": [
                    "whole-part",
                    "part-whole"
                  ],
                  "default": "whole-part",
                  "description": "柱子排列方式，整体-部分或者部分-整体"
                },
                "border": {
                  "type": "object",
                  "properties": {
                    "radius": {
                      "oneOf": [
                        {
                          "type": "number"
                        },
                        {
                          "type": "array",
                          "items": {
                            "type": "number"
                          },
                          "minItems": 4,
                          "maxItems": 4
                        }
                      ],
                      "default": 0
                    },
                    "type": {
                      "type": "string",
                      "enum": [
                        "solid",
                        "dashed",
                        "dotted"
                      ],
                      "default": "solid"
                    },
                    "width": {
                      "type": "number",
                      "default": 0
                    },
                    "color": {
                      "$ref": "commonChartDefinitions.json#/definitions/borderElementColorOption"
                    }
                  },
                  "required": [
                    "radius",
                    "type",
                    "width"
                  ]
                }
              },
              "required": [
                "widthPercent",
                "order",
                "border"
              ]
            }
          },
          "required": [
            "bar"
          ]
        },
        "legend": {
          "$ref": "commonChartDefinitions.json#/definitions/legendConfig"
        },
        "label": {
          "type": "object",
          "description": "标签配置",
          "properties": {
            "show": {
              "type": "boolean",
              "default": true,
              "description": "是否显示所有标签（总开关）"
            },
            "barLabel": {
              "type": "object",
              "properties": {
                "show": {
                  "type": "boolean",
                  "default": true,
                  "description": "是否显示柱状图标签"
                },
                "positionChoice": {
                  "type": "string",
                  "enum": [
                    "outside",
                    "top",
                    "center",
                    "bottom"
                  ],
                  "default": "top"
                },
                "fontFamily": {
                  "type": "string",
                  "default": "Misans 常规"
                },
                "fontSize": {
                  "type": "number",
                  "default": 12
                },
                "color": {
                  "$ref": "commonChartDefinitions.json#/definitions/simpleColor",
                  "default": {
                    "color": "#000000",
                    "opacity": 1
                  }
                },
                "suffix": {
                  "type": "string",
                  "default": ""
                }
              },
              "required": [
                "show",
                "positionChoice",
                "fontFamily",
                "fontSize",
                "color",
                "suffix"
              ]
            },
            "highlight": {
              "type": "boolean",
              "default": false
            },
            "overlap": {
              "type": "boolean",
              "default": false
            }
          },
          "required": [
            "show",
            "barLabel",
            "highlight",
            "overlap"
          ]
        },
        "axis": {
          "type": "object",
          "description": "坐标轴配置",
          "properties": {
            "show": {
              "type": "boolean",
              "default": true
            },
            "xAxis": {
              "type": "array",
              "description": "X轴配置数组 (Category Axis)",
              "items": {
                "type": "object",
                "description": "X轴配置单元",
                "properties": {
                  "line": {
                    "type": "object",
                    "properties": {
                      "show": {
                        "type": "boolean",
                        "default": true
                      },
                      "width": {
                        "type": "number",
                        "default": 1
                      },
                      "color": {
                        "$ref": "commonChartDefinitions.json#/definitions/simpleColor",
                        "default": {
                          "color": "#000000",
                          "opacity": 1
                        }
                      }
                    },
                    "required": [
                      "show",
                      "width",
                      "color"
                    ]
                  },
                  "label": {
                    "type": "object",
                    "properties": {
                      "show": {
                        "type": "boolean",
                        "default": true
                      },
                      "direction": {
                        "type": "string",
                        "enum": [
                          "horizontal",
                          "auto"
                        ],
                        "default": "auto"
                      },
                      "fontFamily": {
                        "type": "string",
                        "default": "Misans 常规"
                      },
                      "fontSize": {
                        "type": "number",
                        "default": 12
                      },
                      "color": {
                        "$ref": "commonChartDefinitions.json#/definitions/simpleColor",
                        "default": {
                          "color": "#000000",
                          "opacity": 1
                        }
                      },
                      "angle": {
                        "type": "number",
                        "default": 0
                      }
                    },
                    "required": [
                      "show",
                      "fontFamily",
                      "fontSize",
                      "color",
                      "angle",
                      "direction"
                    ]
                  },
                  "grid": {
                    "type": "object",
                    "properties": {
                      "show": {
                        "type": "boolean",
                        "default": false
                      },
                      "width": {
                        "type": "number",
                        "default": 1
                      },
                      "color": {
                        "$ref": "commonChartDefinitions.json#/definitions/simpleColor",
                        "default": {
                          "color": "#cccccc",
                          "opacity": 1
                        }
                      },
                      "type": {
                        "type": "string",
                        "enum": [
                          "solid",
                          "dashed",
                          "dotted"
                        ],
                        "default": "solid"
                      }
                    },
                    "required": [
                      "show",
                      "width",
                      "color",
                      "type"
                    ]
                  },
                  "position": {
                    "type": "string",
                    "enum": [
                      "top",
                      "bottom"
                    ],
                    "default": "bottom"
                  },
                  "type": {
                    "type": "string",
                    "enum": [
                      "value",
                      "category",
                      "time",
                      "log"
                    ],
                    "default": "category"
                  }
                },
                "required": [
                  "line",
                  "label",
                  "grid",
                  "position",
                  "type"
                ]
              },
              "minItems": 1,
              "maxItems": 1
            },
            "yAxis": {
              "type": "array",
              "description": "Y轴配置数组 (Value Axis)",
              "items": {
                "type": "object",
                "description": "Y轴配置单元",
                "properties": {
                  "line": {
                    "type": "object",
                    "properties": {
                      "show": {
                        "type": "boolean",
                        "default": true
                      },
                      "width": {
                        "type": "number",
                        "default": 1
                      },
                      "color": {
                        "$ref": "commonChartDefinitions.json#/definitions/simpleColor",
                        "default": {
                          "color": "#000000",
                          "opacity": 1
                        }
                      }
                    },
                    "required": [
                      "show",
                      "width",
                      "color"
                    ]
                  },
                  "label": {
                    "type": "object",
                    "properties": {
                      "show": {
                        "type": "boolean",
                        "default": true
                      },
                      "fontFamily": {
                        "type": "string",
                        "default": "Misans 常规"
                      },
                      "fontSize": {
                        "type": "number",
                        "default": 12
                      },
                      "color": {
                        "$ref": "commonChartDefinitions.json#/definitions/simpleColor",
                        "default": {
                          "color": "#000000",
                          "opacity": 1
                        }
                      },
                      "angle": {
                        "type": "number",
                        "default": 0
                      },
                      "suffix": {
                        "type": "string",
                        "default": ""
                      }
                    },
                    "required": [
                      "show",
                      "fontFamily",
                      "fontSize",
                      "color",
                      "angle",
                      "suffix"
                    ]
                  },
                  "grid": {
                    "type": "object",
                    "properties": {
                      "show": {
                        "type": "boolean",
                        "default": true
                      },
                      "width": {
                        "type": "number",
                        "default": 1
                      },
                      "color": {
                        "$ref": "commonChartDefinitions.json#/definitions/simpleColor",
                        "default": {
                          "color": "#cccccc",
                          "opacity": 1
                        }
                      },
                      "type": {
                        "type": "string",
                        "enum": [
                          "solid",
                          "dashed",
                          "dotted"
                        ],
                        "default": "solid"
                      }
                    },
                    "required": [
                      "show",
                      "width",
                      "color",
                      "type"
                    ]
                  },
                  "position": {
                    "type": "string",
                    "enum": [
                      "left",
                      "right"
                    ],
                    "default": "left"
                  },
                  "type": {
                    "type": "string",
                    "enum": [
                      "value",
                      "category",
                      "time",
                      "log"
                    ],
                    "default": "value"
                  },
                  "stepOfLabel": {
                    "oneOf": [
                      {
                        "type": "number"
                      },
                      {
                        "type": "string",
                        "enum": [
                          "auto"
                        ]
                      }
                    ],
                    "default": "auto"
                  },
                  "range": {
                    "type": "array",
                    "items": {
                      "type": "number"
                    },
                    "default": []
                  }
                },
                "required": [
                  "line",
                  "label",
                  "grid",
                  "position",
                  "type",
                  "stepOfLabel"
                ]
              },
              "minItems": 1,
              "maxItems": 1
            }
          },
          "required": [
            "show",
            "xAxis",
            "yAxis"
          ]
        },
        "numberFormat": {
          "$ref": "commonChartDefinitions.json#/definitions/numberFormatConfig"
        },
        "animation": {
          "$ref": "commonChartDefinitions.json#/definitions/animationConfig"
        },
        "tooltip": {
          "$ref": "commonChartDefinitions.json#/definitions/tooltipConfig"
        },
        "padding": {
          "$ref": "commonChartDefinitions.json#/definitions/paddingConfig"
        }
      },
      "required": [
        "type",
        "title",
        "background",
        "map",
        "fill",
        "display",
        "legend",
        "label",
        "axis",
        "numberFormat",
        "animation",
        "tooltip",
        "padding"
      ]
    }
  },
  "required": [
    "data",
    "pipe",
    "props"
  ]
}