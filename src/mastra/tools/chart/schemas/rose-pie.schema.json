{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.com/schemas/rosePieChartSchema.json",
  "title": "Rose Pie Chart Configuration",
  "description": "Schema for configuring a rose pie chart, with fully inlined axis configurations.",
  "type": "object",
  "properties": {
    "data": {
      "$ref": "commonChartDefinitions.json#/definitions/chartDataArray"
    },
    "pipe": {
      "type": "string",
      "default": "key_value",
      "description": "数据处理方式，例如 \"key_value\""
    },
    "props": {
      "type": "object",
      "description": "图表的配置项",
      "properties": {
        "type": {
          "type": "string",
          "const": "rose-pie",
          "description": "图表类型固定为玫瑰图"
        },
        "title": {
          "$ref": "commonChartDefinitions.json#/definitions/titleConfig"
        },
        "background": {
          "$ref": "commonChartDefinitions.json#/definitions/backgroundConfig"
        },
        "map": {
          "type": "array",
          "description": "数据映射配置 (name, value, potentially controlling angle/radius)",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "description": "映射名称, e.g., '名称' or '值'"
              },
              "index": {
                "type": "number",
                "description": "数据列索引"
              },
              "isLegend": {
                "type": "boolean",
                "description": "第一列是否作为图例，其他列默认为false"
              },
              "function": {
                "type": "string",
                "description": "映射函数类型 (e.g., 'objCol' for category, 'vCol' for value)"
              },
              "configurable": {
                "type": "boolean",
                "description": "图表是否绘制这一列数值"
              },
              "angleIndex": {
                "type": "number",
                "description": "对应的周向轴（角度轴）索引, 若数据驱动角度"
              },
              "radiusIndex": {
                "type": "number",
                "description": "对应的径向轴（半径轴）索引, 若数据驱动半径"
              },
              "type": {
                "type": "string",
                "description": "图表中绘制的元素类型",
                "enum": [
                  "pie"
                ]
              }
            },
            "required": [
              "name",
              "index",
              "isLegend",
              "function",
              "configurable",
              "type"
            ],
            "oneOf": [
              {
                "description": "Must have angleIndex and not radiusIndex.",
                "required": [
                  "angleIndex"
                ],
                "properties": {
                  "radiusIndex": false
                }
              },
              {
                "description": "Must have radiusIndex and not angleIndex.",
                "required": [
                  "radiusIndex"
                ],
                "properties": {
                  "angleIndex": false
                }
              }
            ]
          },
          "minItems": 2
        },
        "fill": {
          "type": "object",
          "description": "扇区颜色配置",
          "properties": {
            "controlType": {
              "type": "string",
              "enum": [
                "single",
                "multiple",
                "gradient"
              ],
              "default": "multiple"
            },
            "props": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "color": {
                    "$ref": "commonChartDefinitions.json#/definitions/colorOption"
                  },
                  "shadow": {
                    "type": "object",
                    "properties": {
                      "show": {
                        "type": "boolean",
                        "default": false
                      },
                      "type": {
                        "type": "string",
                        "enum": [
                          "outer",
                          "inner"
                        ],
                        "default": "outer"
                      },
                      "angle": {
                        "type": "number",
                        "default": 45
                      },
                      "blur": {
                        "type": "number",
                        "default": 5
                      },
                      "color": {
                        "$ref": "commonChartDefinitions.json#/definitions/simpleColor",
                        "default": {
                          "color": "#000000",
                          "opacity": 0.3
                        }
                      },
                      "radius": {
                        "type": "number",
                        "default": 3
                      }
                    }
                  },
                  "border": {
                    "type": "object",
                    "properties": {
                      "type": {
                        "type": "string",
                        "enum": [
                          "solid",
                          "dashed",
                          "dotted"
                        ],
                        "default": "solid"
                      },
                      "width": {
                        "type": "number",
                        "default": 0
                      },
                      "color": {
                        "$ref": "commonChartDefinitions.json#/definitions/borderElementColorOption"
                      }
                    }
                  }
                },
                "required": [
                  "color",
                  "shadow",
                  "border"
                ]
              }
            }
          },
          "required": [
            "controlType",
            "props"
          ]
        },
        "display": {
          "type": "object",
          "description": "显示配置，定义玫瑰图的显示属性",
          "properties": {
            "pie": {
              "type": "object",
              "description": "玫瑰图扇区特定显示属性",
              "properties": {
                "innerRadiusRatio": {
                  "type": "number",
                  "default": 0,
                  "minimum": 0,
                  "maximum": 0.99,
                  "description": "内径占比 (0 for standard rose, >0 for ring/doughnut rose)"
                },
                "gapPercentage": {
                  "type": "number",
                  "default": 0,
                  "minimum": 0,
                  "maximum": 100,
                  "description": "扇区之间的间隙百分比"
                },
                "border": {
                  "type": "object",
                  "properties": {
                    "radius": {
                      "oneOf": [
                        {
                          "type": "number"
                        },
                        {
                          "type": "array",
                          "items": {
                            "type": "number"
                          },
                          "minItems": 4,
                          "maxItems": 4
                        }
                      ],
                      "default": 0,
                      "description": "This usually refers to slice corner rounding if applicable"
                    },
                    "type": {
                      "type": "string",
                      "enum": [
                        "solid",
                        "dashed",
                        "dotted"
                      ],
                      "default": "solid"
                    },
                    "width": {
                      "type": "number",
                      "default": 1
                    },
                    "color": {
                      "$ref": "commonChartDefinitions.json#/definitions/borderElementColorOption"
                    }
                  },
                  "required": [
                    "radius",
                    "type",
                    "width"
                  ]
                }
              },
              "required": [
                "innerRadiusRatio",
                "gapPercentage",
                "border"
              ]
            }
          },
          "required": [
            "pie"
          ]
        },
        "legend": {
          "$ref": "commonChartDefinitions.json#/definitions/legendConfig"
        },
        "label": {
          "type": "object",
          "description": "标签配置",
          "properties": {
            "show": {
              "type": "boolean",
              "default": true,
              "description": "是否显示所有标签（总开关）"
            },
            "textLabel": {
              "type": "object",
              "description": "玫瑰图文字标签 (分类名称)",
              "properties": {
                "show": {
                  "type": "boolean",
                  "default": true
                },
                "positionChoice": {
                  "type": "string",
                  "enum": [
                    "inside-circumference",
                    "inside-horizontal",
                    "outside-edge",
                    "outside-ellipse"
                  ],
                  "default": "outside-ellipse"
                },
                "fontFamily": {
                  "type": "string",
                  "default": "Misans 常规"
                },
                "fontSize": {
                  "type": "number",
                  "default": 12
                },
                "color": {
                  "$ref": "commonChartDefinitions.json#/definitions/simpleColor",
                  "default": {
                    "color": "#000000",
                    "opacity": 1
                  }
                }
              },
              "required": [
                "show",
                "positionChoice",
                "fontFamily",
                "fontSize",
                "color"
              ]
            },
            "numberLabel": {
              "type": "object",
              "description": "玫瑰图数值标签",
              "properties": {
                "show": {
                  "type": "boolean",
                  "default": false
                },
                "positionChoice": {
                  "type": "string",
                  "enum": [
                    "inside-circumference",
                    "inside-horizontal",
                    "outside-edge",
                    "outside-ellipse"
                  ],
                  "default": "inside-horizontal"
                },
                "fontFamily": {
                  "type": "string",
                  "default": "Misans 常规"
                },
                "fontSize": {
                  "type": "number",
                  "default": 12
                },
                "color": {
                  "$ref": "commonChartDefinitions.json#/definitions/simpleColor",
                  "default": {
                    "color": "#000000",
                    "opacity": 1
                  }
                },
                "suffix": {
                  "type": "string",
                  "default": ""
                }
              },
              "required": [
                "show",
                "positionChoice",
                "fontFamily",
                "fontSize",
                "color",
                "suffix"
              ]
            },
            "highlight": {
              "type": "boolean",
              "default": false
            },
            "overlap": {
              "type": "boolean",
              "default": false
            }
          },
          "required": [
            "show",
            "textLabel",
            "numberLabel",
            "highlight",
            "overlap"
          ]
        },
        "axis": {
          "type": "object",
          "description": "坐标轴配置 (周向轴和径向轴)",
          "properties": {
            "show": {
              "type": "boolean",
              "default": true,
              "description": "是否显示坐标轴"
            },
            "angleAxis": {
              "type": "array",
              "description": "周向轴（角度轴）配置数组",
              "items": {
                "type": "object",
                "description": "周向轴配置单元",
                "properties": {
                  "line": {
                    "type": "object",
                    "description": "轴线配置",
                    "properties": {
                      "show": {
                        "type": "boolean",
                        "default": true
                      },
                      "width": {
                        "type": "number",
                        "default": 1
                      },
                      "color": {
                        "$ref": "commonChartDefinitions.json#/definitions/simpleColor",
                        "default": {
                          "color": "#000000",
                          "opacity": 1
                        }
                      }
                    },
                    "required": [
                      "show",
                      "width",
                      "color"
                    ]
                  },
                  "label": {
                    "type": "object",
                    "description": "轴标签配置",
                    "properties": {
                      "show": {
                        "type": "boolean",
                        "default": true
                      },
                      "direction": {
                        "type": "string",
                        "enum": [
                          "horizontal",
                          "circumference",
                          "radial"
                        ],
                        "default": "circumference"
                      },
                      "fontFamily": {
                        "type": "string",
                        "default": "Misans 常规"
                      },
                      "fontSize": {
                        "type": "number",
                        "default": 12
                      },
                      "color": {
                        "$ref": "commonChartDefinitions.json#/definitions/simpleColor",
                        "default": {
                          "color": "#000000",
                          "opacity": 1
                        }
                      }
                    },
                    "required": [
                      "show",
                      "direction",
                      "fontFamily",
                      "fontSize",
                      "color"
                    ]
                  },
                  "grid": {
                    "type": "object",
                    "description": "轴网格线配置 (通常是径向分隔线)",
                    "properties": {
                      "show": {
                        "type": "boolean",
                        "default": true
                      },
                      "width": {
                        "type": "number",
                        "default": 1
                      },
                      "color": {
                        "$ref": "commonChartDefinitions.json#/definitions/simpleColor",
                        "default": {
                          "color": "#cccccc",
                          "opacity": 1
                        }
                      },
                      "type": {
                        "type": "string",
                        "enum": [
                          "solid",
                          "dashed",
                          "dotted"
                        ],
                        "default": "dashed"
                      }
                    },
                    "required": [
                      "show",
                      "width",
                      "color",
                      "type"
                    ]
                  },
                  "position": {
                    "type": "string",
                    "enum": [
                      "inside",
                      "outside"
                    ],
                    "default": "outside",
                    "description": "轴线及标签位置"
                  },
                  "type": {
                    "type": "string",
                    "enum": [
                      "value",
                      "category",
                      "time",
                      "log"
                    ],
                    "default": "category",
                    "description": "周向轴类型 (通常为 category for slices)"
                  }
                },
                "required": [
                  "line",
                  "label",
                  "grid",
                  "position",
                  "type"
                ]
              },
              "minItems": 1,
              "maxItems": 1
            },
            "radiusAxis": {
              "type": "array",
              "description": "径向轴（半径轴）配置数组",
              "items": {
                "type": "object",
                "description": "径向轴配置单元",
                "properties": {
                  "line": {
                    "type": "object",
                    "description": "轴线配置",
                    "properties": {
                      "show": {
                        "type": "boolean",
                        "default": false
                      },
                      "width": {
                        "type": "number",
                        "default": 1
                      },
                      "color": {
                        "$ref": "commonChartDefinitions.json#/definitions/simpleColor",
                        "default": {
                          "color": "#000000",
                          "opacity": 1
                        }
                      }
                    },
                    "required": [
                      "show",
                      "width",
                      "color"
                    ]
                  },
                  "label": {
                    "type": "object",
                    "description": "轴标签配置",
                    "properties": {
                      "show": {
                        "type": "boolean",
                        "default": true
                      },
                      "fontFamily": {
                        "type": "string",
                        "default": "Misans 常规"
                      },
                      "fontSize": {
                        "type": "number",
                        "default": 12
                      },
                      "color": {
                        "$ref": "commonChartDefinitions.json#/definitions/simpleColor",
                        "default": {
                          "color": "#000000",
                          "opacity": 1
                        }
                      },
                      "suffix": {
                        "type": "string",
                        "default": ""
                      }
                    },
                    "required": [
                      "show",
                      "fontFamily",
                      "fontSize",
                      "color",
                      "suffix"
                    ]
                  },
                  "grid": {
                    "type": "object",
                    "description": "轴网格线配置 (通常是同心圆)",
                    "properties": {
                      "show": {
                        "type": "boolean",
                        "default": true
                      },
                      "width": {
                        "type": "number",
                        "default": 1
                      },
                      "color": {
                        "$ref": "commonChartDefinitions.json#/definitions/simpleColor",
                        "default": {
                          "color": "#cccccc",
                          "opacity": 1
                        }
                      },
                      "type": {
                        "type": "string",
                        "enum": [
                          "solid",
                          "dashed",
                          "dotted"
                        ],
                        "default": "solid"
                      }
                    },
                    "required": [
                      "show",
                      "width",
                      "color",
                      "type"
                    ]
                  },
                  "position": {
                    "type": "string",
                    "enum": [
                      "inside",
                      "outside"
                    ],
                    "default": "inside",
                    "description": "轴线及标签位置"
                  },
                  "type": {
                    "type": "string",
                    "enum": [
                      "value",
                      "category",
                      "time",
                      "log"
                    ],
                    "default": "value",
                    "description": "径向轴类型 (通常为 value)"
                  },
                  "stepOfLabel": {
                    "oneOf": [
                      {
                        "type": "number"
                      },
                      {
                        "type": "string",
                        "enum": [
                          "auto"
                        ]
                      }
                    ],
                    "default": "auto"
                  },
                  "range": {
                    "type": "array",
                    "items": {
                      "type": "number"
                    },
                    "default": [],
                    "description": "坐标轴范围 [min, max]"
                  }
                },
                "required": [
                  "line",
                  "label",
                  "grid",
                  "position",
                  "type",
                  "stepOfLabel"
                ]
              },
              "minItems": 1,
              "maxItems": 1
            }
          },
          "required": [
            "show",
            "angleAxis",
            "radiusAxis"
          ]
        },
        "numberFormat": {
          "$ref": "commonChartDefinitions.json#/definitions/numberFormatConfig"
        },
        "animation": {
          "$ref": "commonChartDefinitions.json#/definitions/animationConfig"
        },
        "tooltip": {
          "$ref": "commonChartDefinitions.json#/definitions/tooltipConfig"
        },
        "padding": {
          "$ref": "commonChartDefinitions.json#/definitions/paddingConfig"
        }
      },
      "required": [
        "type",
        "title",
        "background",
        "map",
        "fill",
        "display",
        "legend",
        "label",
        "axis",
        "numberFormat",
        "animation",
        "tooltip",
        "padding"
      ]
    }
  },
  "required": [
    "data",
    "pipe",
    "props"
  ]
}