{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "https://example.com/schemas/checkInBubbleChartSchema.json",
    "title": "Check-in Bubble Chart Configuration",
    "description": "Schema for configuring a check-in bubble chart, with fully inlined axis configurations.",
    "type": "object",
    "properties": {
        "data": {
            "$ref": "commonChartDefinitions.json#/definitions/chartDataArray"
        },
        "pipe": {
            "type": "string",
            "default": "cross",
            "description": "数据处理方式，例如 \"cross\""
        },
        "props": {
            "type": "object",
            "description": "图表的配置项",
            "properties": {
                "type": {
                    "type": "string",
                    "const": "check-in-bubble",
                    "description": "图表类型固定为打卡气泡图"
                },
                "title": {
                    "$ref": "commonChartDefinitions.json#/definitions/titleConfig"
                },
                "background": {
                    "$ref": "commonChartDefinitions.json#/definitions/backgroundConfig"
                },
                "map": {
                    "type": "array",
                    "description": "数据映射配置 (X-category, Y-category, Value for bubble size)",
                    "items": {
                        "type": "object",
                        "properties": {
                            "name": {
                                "type": "string",
                                "description": "映射名称, e.g., 'X轴对象', 'Y轴对象', '气泡大小值'"
                            },
                            "index": {
                                "type": "number",
                                "description": "数据列索引"
                            },
                            "isLegend": {
                                "type": "boolean",
                                "default": false,
                                "description": "第一列是否作为图例，其他列默认为false"
                            },
                            "function": {
                                "type": "string",
                                "description": "映射函数类型 (e.g., 'objCol', 'vCol')"
                            },
                            "configurable": {
                                "type": "boolean",
                                "description": "图表是否绘制这一列数值"
                            },
                            "xAxisIndex": {
                                "type": "number",
                                "default": 0
                            },
                            "yAxisIndex": {
                                "type": "number",
                                "default": 0
                            },
                            "type": {
                                "type": "string",
                                "description": "图表中绘制的元素类型 (bubble)",
                                "enum": [
                                    "bar"
                                ]
                            }
                        },
                        "required": [
                            "name",
                            "index",
                            "isLegend",
                            "function",
                            "configurable",
                            "type"
                        ],
                        "oneOf": [
                            {
                                "description": "Must have xAxisIndex and not yAxisIndex.",
                                "required": [
                                    "xAxisIndex"
                                ],
                                "properties": {
                                    "yAxisIndex": false
                                }
                            },
                            {
                                "description": "Must have yAxisIndex and not xAxisIndex.",
                                "required": [
                                    "yAxisIndex"
                                ],
                                "properties": {
                                    "xAxisIndex": false
                                }
                            }
                        ]
                    },
                    "minItems": 3,
                    "maxItems": 3
                },
                "fill": {
                    "type": "object",
                    "description": "气泡颜色配置",
                    "properties": {
                        "controlType": {
                            "type": "string",
                            "enum": [
                                "single",
                                "multiple",
                                "gradient"
                            ],
                            "default": "multiple"
                        },
                        "props": {
                            "type": "array",
                            "items": {
                                "type": "object",
                                "properties": {
                                    "color": {
                                        "$ref": "commonChartDefinitions.json#/definitions/colorOption"
                                    },
                                    "shadow": {
                                        "type": "object",
                                        "properties": {
                                            "show": {
                                                "type": "boolean",
                                                "default": false
                                            },
                                            "type": {
                                                "type": "string",
                                                "enum": [
                                                    "outer",
                                                    "inner"
                                                ],
                                                "default": "outer"
                                            },
                                            "angle": {
                                                "type": "number",
                                                "default": 45
                                            },
                                            "blur": {
                                                "type": "number",
                                                "default": 3
                                            },
                                            "color": {
                                                "$ref": "commonChartDefinitions.json#/definitions/simpleColor",
                                                "default": {
                                                    "color": "#000000",
                                                    "opacity": 0.2
                                                }
                                            },
                                            "radius": {
                                                "type": "number",
                                                "default": 2
                                            }
                                        }
                                    },
                                    "border": {
                                        "type": "object",
                                        "properties": {
                                            "type": {
                                                "type": "string",
                                                "enum": [
                                                    "solid",
                                                    "dashed",
                                                    "dotted"
                                                ],
                                                "default": "solid"
                                            },
                                            "width": {
                                                "type": "number",
                                                "default": 0
                                            },
                                            "color": {
                                                "$ref": "commonChartDefinitions.json#/definitions/borderElementColorOption"
                                            }
                                        }
                                    }
                                },
                                "required": [
                                    "color",
                                    "shadow",
                                    "border"
                                ]
                            }
                        }
                    },
                    "required": [
                        "controlType",
                        "props"
                    ]
                },
                "display": {
                    "type": "object",
                    "description": "显示配置，定义气泡的显示属性",
                    "properties": {
                        "bubble": {
                            "type": "object",
                            "description": "气泡特定显示属性",
                            "properties": {
                                "standard": {
                                    "type": "string",
                                    "enum": [
                                        "radius",
                                        "area"
                                    ],
                                    "default": "radius",
                                    "description": "气泡绘制基准，气泡半径或者气泡面积"
                                },
                                "size": {
                                    "type": "array",
                                    "items": {
                                        "type": "number"
                                    },
                                    "minItems": 2,
                                    "maxItems": 2,
                                    "description": "气泡半径/面积映射范围 [minSize, maxSize]",
                                    "default": [
                                        5,
                                        15
                                    ]
                                },
                                "shape": {
                                    "type": "string",
                                    "enum": [
                                        "circle",
                                        "square",
                                        "triangle",
                                        "diamond"
                                    ],
                                    "default": "circle",
                                    "description": "气泡形状"
                                },
                                "border": {
                                    "type": "object",
                                    "description": "气泡统一边框配置",
                                    "properties": {
                                        "type": {
                                            "type": "string",
                                            "enum": [
                                                "solid",
                                                "dashed",
                                                "dotted"
                                            ],
                                            "default": "solid"
                                        },
                                        "width": {
                                            "type": "number",
                                            "default": 1
                                        },
                                        "color": {
                                            "$ref": "commonChartDefinitions.json#/definitions/borderElementColorOption",
                                            "description": "null表示自动色，即与气泡填充色相同或预定义对比色"
                                        }
                                    },
                                    "required": [
                                        "type",
                                        "width"
                                    ]
                                },
                                "reference": {
                                    "type": "object",
                                    "description": "参考值配置项 (e.g., an average bubble size)",
                                    "properties": {
                                        "show": {
                                            "type": "boolean",
                                            "default": false,
                                            "description": "是否显示参考值 (e.g. a reference bubble or line)"
                                        },
                                        "text": {
                                            "type": "string",
                                            "description": "参考值名称"
                                        },
                                        "value": {
                                            "type": "number",
                                            "description": "参考值"
                                        },
                                        "color": {
                                            "$ref": "commonChartDefinitions.json#/definitions/colorOption",
                                            "description": "参考元素填充颜色"
                                        },
                                        "border": {
                                            "type": "object",
                                            "description": "参考元素边框配置",
                                            "properties": {
                                                "type": {
                                                    "type": "string",
                                                    "enum": [
                                                        "solid",
                                                        "dashed",
                                                        "dotted"
                                                    ],
                                                    "default": "dashed"
                                                },
                                                "width": {
                                                    "type": "number",
                                                    "default": 1
                                                },
                                                "color": {
                                                    "$ref": "commonChartDefinitions.json#/definitions/colorOption",
                                                    "description": "参考元素边框颜色"
                                                }
                                            },
                                            "required": [
                                                "type",
                                                "width",
                                                "color"
                                            ]
                                        }
                                    },
                                    "required": [
                                        "show",
                                        "text",
                                        "value",
                                        "color",
                                        "border"
                                    ]
                                },
                                "fillOpacity": {
                                    "type": "number",
                                    "minimum": 0,
                                    "maximum": 1,
                                    "default": 0.75,
                                    "description": "气泡整体填充透明度"
                                }
                            },
                            "required": [
                                "standard",
                                "size",
                                "shape",
                                "border",
                                "reference",
                                "fillOpacity"
                            ]
                        }
                    },
                    "required": [
                        "bubble"
                    ]
                },
                "legend": {
                    "$ref": "commonChartDefinitions.json#/definitions/legendConfig"
                },
                "label": {
                    "type": "object",
                    "description": "标签配置",
                    "properties": {
                        "show": {
                            "type": "boolean",
                            "default": false,
                            "description": "是否显示所有标签（总开关）"
                        },
                        "numberLabel": {
                            "type": "object",
                            "description": "气泡数值标签",
                            "properties": {
                                "show": {
                                    "type": "boolean",
                                    "default": false,
                                    "description": "是否显示气泡数值标签"
                                },
                                "fontFamily": {
                                    "type": "string",
                                    "default": "Misans 常规"
                                },
                                "fontSize": {
                                    "type": "number",
                                    "default": 10
                                },
                                "color": {
                                    "$ref": "commonChartDefinitions.json#/definitions/simpleColor",
                                    "default": {
                                        "color": "#000000",
                                        "opacity": 1
                                    }
                                },
                                "suffix": {
                                    "type": "string",
                                    "default": ""
                                }
                            },
                            "required": [
                                "show",
                                "fontFamily",
                                "fontSize",
                                "color",
                                "suffix"
                            ]
                        },
                        "highlight": {
                            "type": "boolean",
                            "default": false
                        },
                        "overlap": {
                            "type": "boolean",
                            "default": false,
                            "description": "是否允许标签重叠 (important for dense bubbles)"
                        }
                    },
                    "required": [
                        "show",
                        "numberLabel",
                        "highlight",
                        "overlap"
                    ]
                },
                "axis": {
                    "type": "object",
                    "description": "坐标轴配置 (X 和 Y 均为类目轴)",
                    "properties": {
                        "show": {
                            "type": "boolean",
                            "default": true
                        },
                        "xAxis": {
                            "type": "array",
                            "description": "X轴配置数组 (Category Axis)",
                            "items": {
                                "type": "object",
                                "description": "X轴配置单元",
                                "properties": {
                                    "line": {
                                        "type": "object",
                                        "properties": {
                                            "show": {
                                                "type": "boolean",
                                                "default": true
                                            },
                                            "width": {
                                                "type": "number",
                                                "default": 1
                                            },
                                            "color": {
                                                "$ref": "commonChartDefinitions.json#/definitions/simpleColor",
                                                "default": {
                                                    "color": "#000000",
                                                    "opacity": 1
                                                }
                                            }
                                        },
                                        "required": [
                                            "show",
                                            "width",
                                            "color"
                                        ]
                                    },
                                    "label": {
                                        "type": "object",
                                        "properties": {
                                            "show": {
                                                "type": "boolean",
                                                "default": true
                                            },
                                            "direction": {
                                                "type": "string",
                                                "enum": [
                                                    "horizontal",
                                                    "auto"
                                                ],
                                                "default": "auto"
                                            },
                                            "fontFamily": {
                                                "type": "string",
                                                "default": "Misans 常规"
                                            },
                                            "fontSize": {
                                                "type": "number",
                                                "default": 12
                                            },
                                            "color": {
                                                "$ref": "commonChartDefinitions.json#/definitions/simpleColor",
                                                "default": {
                                                    "color": "#000000",
                                                    "opacity": 1
                                                }
                                            },
                                            "angle": {
                                                "type": "number",
                                                "default": 0
                                            }
                                        },
                                        "required": [
                                            "show",
                                            "fontFamily",
                                            "fontSize",
                                            "color",
                                            "angle",
                                            "direction"
                                        ]
                                    },
                                    "grid": {
                                        "type": "object",
                                        "properties": {
                                            "show": {
                                                "type": "boolean",
                                                "default": true
                                            },
                                            "width": {
                                                "type": "number",
                                                "default": 1
                                            },
                                            "color": {
                                                "$ref": "commonChartDefinitions.json#/definitions/simpleColor",
                                                "default": {
                                                    "color": "#cccccc",
                                                    "opacity": 0.5
                                                }
                                            },
                                            "type": {
                                                "type": "string",
                                                "enum": [
                                                    "solid",
                                                    "dashed",
                                                    "dotted"
                                                ],
                                                "default": "dashed"
                                            }
                                        },
                                        "required": [
                                            "show",
                                            "width",
                                            "color",
                                            "type"
                                        ]
                                    },
                                    "position": {
                                        "type": "string",
                                        "enum": [
                                            "top",
                                            "bottom"
                                        ],
                                        "default": "bottom"
                                    },
                                    "type": {
                                        "type": "string",
                                        "enum": [
                                            "category"
                                        ],
                                        "default": "category",
                                        "description": "X轴类型固定为类目轴"
                                    }
                                },
                                "required": [
                                    "line",
                                    "label",
                                    "grid",
                                    "position",
                                    "type"
                                ]
                            },
                            "minItems": 1,
                            "maxItems": 1
                        },
                        "yAxis": {
                            "type": "array",
                            "description": "Y轴配置数组 (Category Axis)",
                            "items": {
                                "type": "object",
                                "description": "Y轴配置单元",
                                "properties": {
                                    "line": {
                                        "type": "object",
                                        "properties": {
                                            "show": {
                                                "type": "boolean",
                                                "default": true
                                            },
                                            "width": {
                                                "type": "number",
                                                "default": 1
                                            },
                                            "color": {
                                                "$ref": "commonChartDefinitions.json#/definitions/simpleColor",
                                                "default": {
                                                    "color": "#000000",
                                                    "opacity": 1
                                                }
                                            }
                                        },
                                        "required": [
                                            "show",
                                            "width",
                                            "color"
                                        ]
                                    },
                                    "label": {
                                        "type": "object",
                                        "properties": {
                                            "show": {
                                                "type": "boolean",
                                                "default": true
                                            },
                                            "fontFamily": {
                                                "type": "string",
                                                "default": "Misans 常规"
                                            },
                                            "fontSize": {
                                                "type": "number",
                                                "default": 12
                                            },
                                            "color": {
                                                "$ref": "commonChartDefinitions.json#/definitions/simpleColor",
                                                "default": {
                                                    "color": "#000000",
                                                    "opacity": 1
                                                }
                                            },
                                            "angle": {
                                                "type": "number",
                                                "default": 0
                                            },
                                            "suffix": {
                                                "type": "string",
                                                "default": ""
                                            }
                                        },
                                        "required": [
                                            "show",
                                            "fontFamily",
                                            "fontSize",
                                            "color",
                                            "angle",
                                            "suffix"
                                        ]
                                    },
                                    "grid": {
                                        "type": "object",
                                        "properties": {
                                            "show": {
                                                "type": "boolean",
                                                "default": true
                                            },
                                            "width": {
                                                "type": "number",
                                                "default": 1
                                            },
                                            "color": {
                                                "$ref": "commonChartDefinitions.json#/definitions/simpleColor",
                                                "default": {
                                                    "color": "#cccccc",
                                                    "opacity": 0.5
                                                }
                                            },
                                            "type": {
                                                "type": "string",
                                                "enum": [
                                                    "solid",
                                                    "dashed",
                                                    "dotted"
                                                ],
                                                "default": "dashed"
                                            }
                                        },
                                        "required": [
                                            "show",
                                            "width",
                                            "color",
                                            "type"
                                        ]
                                    },
                                    "position": {
                                        "type": "string",
                                        "enum": [
                                            "left",
                                            "right"
                                        ],
                                        "default": "left"
                                    },
                                    "type": {
                                        "type": "string",
                                        "enum": [
                                            "category"
                                        ],
                                        "default": "category",
                                        "description": "Y轴类型固定为类目轴"
                                    }
                                },
                                "required": [
                                    "line",
                                    "label",
                                    "grid",
                                    "position",
                                    "type"
                                ]
                            },
                            "minItems": 1,
                            "maxItems": 1
                        }
                    },
                    "required": [
                        "show",
                        "xAxis",
                        "yAxis"
                    ]
                },
                "numberFormat": {
                    "$ref": "commonChartDefinitions.json#/definitions/numberFormatConfig"
                },
                "animation": {
                    "$ref": "commonChartDefinitions.json#/definitions/animationConfig"
                },
                "tooltip": {
                    "$ref": "commonChartDefinitions.json#/definitions/tooltipConfig"
                },
                "padding": {
                    "$ref": "commonChartDefinitions.json#/definitions/paddingConfig"
                }
            },
            "required": [
                "type",
                "title",
                "background",
                "map",
                "fill",
                "display",
                "legend",
                "label",
                "axis",
                "numberFormat",
                "animation",
                "tooltip",
                "padding"
            ]
        }
    },
    "required": [
        "data",
        "pipe",
        "props"
    ]
}