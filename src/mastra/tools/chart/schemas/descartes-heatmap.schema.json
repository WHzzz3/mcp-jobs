{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.com/schemas/descartesHeatmapSchema.json",
  "title": "Descartes Heatmap Configuration",
  "description": "Schema for configuring a Descartes heatmap, with fully inlined axis configurations.",
  "type": "object",
  "properties": {
    "data": {
      "$ref": "commonChartDefinitions.json#/definitions/chartDataArray"
    },
    "pipe": {
      "type": "string",
      "default": "cross",
      "description": "数据处理方式，例如 \"cross\""
    },
    "props": {
      "type": "object",
      "description": "图表的配置项",
      "properties": {
        "type": {
          "type": "string",
          "const": "descartes-heatmap",
          "description": "图表类型固定为笛卡尔热力图"
        },
        "title": {
          "$ref": "commonChartDefinitions.json#/definitions/titleConfig"
        },
        "background": {
          "$ref": "commonChartDefinitions.json#/definitions/backgroundConfig"
        },
        "map": {
          "type": "array",
          "description": "数据映射配置 (X-category, Y-category, Value)",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "description": "映射名称, e.g., 'X轴对象', 'Y轴对象', '数值'"
              },
              "index": {
                "type": "number",
                "description": "数据列索引"
              },
              "isLegend": {
                "type": "boolean",
                "default": false,
                "description": "第一列是否作为图例，其他列默认为false"
              },
              "function": {
                "type": "string",
                "description": "映射函数类型 (e.g., 'objCol', 'vCol')"
              },
              "configurable": {
                "type": "boolean",
                "description": "图表是否绘制这一列数值"
              },
              "xAxisIndex": {
                "type": "number",
                "default": 0
              },
              "yAxisIndex": {
                "type": "number",
                "default": 0
              },
              "type": {
                "type": "string",
                "description": "图表中绘制的元素类型 (heatmap cell)",
                "enum": [
                  "bar"
                ]
              }
            },
            "required": [
              "name",
              "index",
              "isLegend",
              "function",
              "configurable",
              "type"
            ],
            "oneOf": [
              {
                "description": "Must have xAxisIndex and not yAxisIndex.",
                "required": [
                  "xAxisIndex"
                ],
                "properties": {
                  "yAxisIndex": false
                }
              },
              {
                "description": "Must have yAxisIndex and not xAxisIndex.",
                "required": [
                  "yAxisIndex"
                ],
                "properties": {
                  "xAxisIndex": false
                }
              }
            ]
          },
          "minItems": 3,
          "maxItems": 3
        },
        "fill": {
          "type": "object",
          "description": "热力单元格颜色配置 (如果是单色，则数据值可能驱动不透明度或需要外部色阶)",
          "properties": {
            "controlType": {
              "type": "string",
              "const": "single",
              "description": "填充控制类型，对于热力图通常需要一个颜色范围/梯度，此处TS指定为single"
            },
            "props": {
              "type": "array",
              "description": "颜色属性定义 (若controlType为single, 通常只有一个item)",
              "items": {
                "type": "object",
                "properties": {
                  "color": {
                    "$ref": "commonChartDefinitions.json#/definitions/colorOption"
                  },
                  "shadow": {
                    "type": "object",
                    "properties": {
                      "show": {
                        "type": "boolean",
                        "default": false
                      },
                      "type": {
                        "type": "string",
                        "enum": [
                          "outer",
                          "inner"
                        ],
                        "default": "outer"
                      },
                      "angle": {
                        "type": "number",
                        "default": 45
                      },
                      "blur": {
                        "type": "number",
                        "default": 2
                      },
                      "color": {
                        "$ref": "commonChartDefinitions.json#/definitions/simpleColor",
                        "default": {
                          "color": "#000000",
                          "opacity": 0.1
                        }
                      },
                      "radius": {
                        "type": "number",
                        "default": 1
                      }
                    }
                  },
                  "border": {
                    "type": "object",
                    "properties": {
                      "type": {
                        "type": "string",
                        "enum": [
                          "solid",
                          "dashed",
                          "dotted"
                        ],
                        "default": "solid"
                      },
                      "width": {
                        "type": "number",
                        "default": 0
                      },
                      "color": {
                        "$ref": "commonChartDefinitions.json#/definitions/borderElementColorOption"
                      }
                    }
                  }
                },
                "required": [
                  "color",
                  "shadow",
                  "border"
                ]
              },
              "minItems": 1,
              "maxItems": 1
            }
          },
          "required": [
            "controlType",
            "props"
          ]
        },
        "display": {
          "type": "object",
          "description": "显示配置，定义热力图单元格的显示属性",
          "properties": {
            "bar": {
              "type": "object",
              "description": "热力图单元格显示属性",
              "properties": {
                "gapDistance": {
                  "type": "number",
                  "default": 0,
                  "minimum": 0,
                  "description": "矩形单元格之间的间隙"
                },
                "border": {
                  "type": "object",
                  "properties": {
                    "radius": {
                      "oneOf": [
                        {
                          "type": "number"
                        },
                        {
                          "type": "array",
                          "items": {
                            "type": "number"
                          },
                          "minItems": 4,
                          "maxItems": 4
                        }
                      ],
                      "default": 0
                    },
                    "type": {
                      "type": "string",
                      "enum": [
                        "solid",
                        "dashed",
                        "dotted"
                      ],
                      "default": "solid"
                    },
                    "width": {
                      "type": "number",
                      "default": 0
                    },
                    "color": {
                      "$ref": "commonChartDefinitions.json#/definitions/borderElementColorOption"
                    }
                  },
                  "required": [
                    "radius",
                    "type",
                    "width"
                  ]
                }
              },
              "required": [
                "gapDistance",
                "border"
              ]
            }
          },
          "required": [
            "bar"
          ]
        },
        "legend": {
          "$ref": "commonChartDefinitions.json#/definitions/legendConfig"
        },
        "label": {
          "type": "object",
          "description": "标签配置",
          "properties": {
            "show": {
              "type": "boolean",
              "default": false,
              "description": "是否显示所有标签（总开关）"
            },
            "barLabel": {
              "type": "object",
              "properties": {
                "show": {
                  "type": "boolean",
                  "default": false,
                  "description": "是否显示单元格标签"
                },
                "fontFamily": {
                  "type": "string",
                  "default": "Misans 常规"
                },
                "fontSize": {
                  "type": "number",
                  "default": 10
                },
                "color": {
                  "$ref": "commonChartDefinitions.json#/definitions/simpleColor",
                  "default": {
                    "color": "#000000",
                    "opacity": 1
                  }
                },
                "suffix": {
                  "type": "string",
                  "default": ""
                }
              },
              "required": [
                "show",
                "fontFamily",
                "fontSize",
                "color",
                "suffix"
              ]
            },
            "highlight": {
              "type": "boolean",
              "default": false
            },
            "overlap": {
              "type": "boolean",
              "default": false
            }
          },
          "required": [
            "show",
            "barLabel",
            "highlight",
            "overlap"
          ]
        },
        "axis": {
          "type": "object",
          "description": "坐标轴配置 (X 和 Y 均为类目轴)",
          "properties": {
            "show": {
              "type": "boolean",
              "default": true
            },
            "xAxis": {
              "type": "array",
              "description": "X轴配置数组 (Category Axis)",
              "items": {
                "type": "object",
                "description": "X轴配置单元",
                "properties": {
                  "line": {
                    "type": "object",
                    "properties": {
                      "show": {
                        "type": "boolean",
                        "default": true
                      },
                      "width": {
                        "type": "number",
                        "default": 1
                      },
                      "color": {
                        "$ref": "commonChartDefinitions.json#/definitions/simpleColor",
                        "default": {
                          "color": "#000000",
                          "opacity": 1
                        }
                      }
                    },
                    "required": [
                      "show",
                      "width",
                      "color"
                    ]
                  },
                  "label": {
                    "type": "object",
                    "properties": {
                      "show": {
                        "type": "boolean",
                        "default": true
                      },
                      "direction": {
                        "type": "string",
                        "enum": [
                          "horizontal",
                          "auto"
                        ],
                        "default": "auto"
                      },
                      "fontFamily": {
                        "type": "string",
                        "default": "Misans 常规"
                      },
                      "fontSize": {
                        "type": "number",
                        "default": 12
                      },
                      "color": {
                        "$ref": "commonChartDefinitions.json#/definitions/simpleColor",
                        "default": {
                          "color": "#000000",
                          "opacity": 1
                        }
                      },
                      "angle": {
                        "type": "number",
                        "default": 0
                      }
                    },
                    "required": [
                      "show",
                      "fontFamily",
                      "fontSize",
                      "color",
                      "angle",
                      "direction"
                    ]
                  },
                  "grid": {
                    "type": "object",
                    "properties": {
                      "show": {
                        "type": "boolean",
                        "default": true
                      },
                      "width": {
                        "type": "number",
                        "default": 1
                      },
                      "color": {
                        "$ref": "commonChartDefinitions.json#/definitions/simpleColor",
                        "default": {
                          "color": "#cccccc",
                          "opacity": 0.5
                        }
                      },
                      "type": {
                        "type": "string",
                        "enum": [
                          "solid",
                          "dashed",
                          "dotted"
                        ],
                        "default": "solid"
                      }
                    },
                    "required": [
                      "show",
                      "width",
                      "color",
                      "type"
                    ]
                  },
                  "position": {
                    "type": "string",
                    "enum": [
                      "top",
                      "bottom"
                    ],
                    "default": "bottom"
                  },
                  "type": {
                    "type": "string",
                    "enum": [
                      "category"
                    ],
                    "default": "category",
                    "description": "X轴类型固定为类目轴"
                  }
                },
                "required": [
                  "line",
                  "label",
                  "grid",
                  "position",
                  "type"
                ]
              },
              "minItems": 1,
              "maxItems": 1
            },
            "yAxis": {
              "type": "array",
              "description": "Y轴配置数组 (Category Axis)",
              "items": {
                "type": "object",
                "description": "Y轴配置单元",
                "properties": {
                  "line": {
                    "type": "object",
                    "properties": {
                      "show": {
                        "type": "boolean",
                        "default": true
                      },
                      "width": {
                        "type": "number",
                        "default": 1
                      },
                      "color": {
                        "$ref": "commonChartDefinitions.json#/definitions/simpleColor",
                        "default": {
                          "color": "#000000",
                          "opacity": 1
                        }
                      }
                    },
                    "required": [
                      "show",
                      "width",
                      "color"
                    ]
                  },
                  "label": {
                    "type": "object",
                    "properties": {
                      "show": {
                        "type": "boolean",
                        "default": true
                      },
                      "fontFamily": {
                        "type": "string",
                        "default": "Misans 常规"
                      },
                      "fontSize": {
                        "type": "number",
                        "default": 12
                      },
                      "color": {
                        "$ref": "commonChartDefinitions.json#/definitions/simpleColor",
                        "default": {
                          "color": "#000000",
                          "opacity": 1
                        }
                      },
                      "angle": {
                        "type": "number",
                        "default": 0
                      },
                      "suffix": {
                        "type": "string",
                        "default": ""
                      }
                    },
                    "required": [
                      "show",
                      "fontFamily",
                      "fontSize",
                      "color",
                      "angle",
                      "suffix"
                    ]
                  },
                  "grid": {
                    "type": "object",
                    "properties": {
                      "show": {
                        "type": "boolean",
                        "default": true
                      },
                      "width": {
                        "type": "number",
                        "default": 1
                      },
                      "color": {
                        "$ref": "commonChartDefinitions.json#/definitions/simpleColor",
                        "default": {
                          "color": "#cccccc",
                          "opacity": 0.5
                        }
                      },
                      "type": {
                        "type": "string",
                        "enum": [
                          "solid",
                          "dashed",
                          "dotted"
                        ],
                        "default": "solid"
                      }
                    },
                    "required": [
                      "show",
                      "width",
                      "color",
                      "type"
                    ]
                  },
                  "position": {
                    "type": "string",
                    "enum": [
                      "left",
                      "right"
                    ],
                    "default": "left"
                  },
                  "type": {
                    "type": "string",
                    "enum": [
                      "category"
                    ],
                    "default": "category",
                    "description": "Y轴类型固定为类目轴"
                  }
                },
                "required": [
                  "line",
                  "label",
                  "grid",
                  "position",
                  "type"
                ]
              },
              "minItems": 1,
              "maxItems": 1
            }
          },
          "required": [
            "show",
            "xAxis",
            "yAxis"
          ]
        },
        "numberFormat": {
          "$ref": "commonChartDefinitions.json#/definitions/numberFormatConfig"
        },
        "animation": {
          "$ref": "commonChartDefinitions.json#/definitions/animationConfig"
        },
        "tooltip": {
          "$ref": "commonChartDefinitions.json#/definitions/tooltipConfig"
        },
        "padding": {
          "$ref": "commonChartDefinitions.json#/definitions/paddingConfig"
        }
      },
      "required": [
        "type",
        "title",
        "background",
        "map",
        "fill",
        "display",
        "legend",
        "label",
        "axis",
        "numberFormat",
        "animation",
        "tooltip",
        "padding"
      ]
    }
  },
  "required": [
    "data",
    "pipe",
    "props"
  ]
}