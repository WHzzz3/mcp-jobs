{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.com/schemas/stackedColumnChartSchema.json",
  "title": "Stacked Column Chart Configuration",
  "description": "Schema for configuring a stacked column chart, referencing common definitions.",
  "type": "object",
  "properties": {
    "data": {
      "$ref": "commonChartDefinitions.json#/definitions/chartDataArray"
    },
    "pipe": {
      "type": "string",
      "default": "cross",
      "description": "数据处理方式，用于图表绘制时的数据转换或处理流程，例如 \"cross\""
    },
    "props": {
      "type": "object",
      "description": "图表的配置项",
      "properties": {
        "type": {
          "type": "string",
          "const": "stacked-column",
          "description": "图表类型固定为堆叠柱状图"
        },
        "title": {
          "$ref": "commonChartDefinitions.json#/definitions/titleConfig"
        },
        "background": {
          "$ref": "commonChartDefinitions.json#/definitions/backgroundConfig"
        },
        "map": {
          "type": "array",
          "description": "数据映射配置，定义数据列如何映射到图表的各个部分",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "description": "映射名称，例如 \"X轴对象\"或者\"数值列\""
              },
              "index": {
                "type": "number",
                "description": "数据列索引"
              },
              "isLegend": {
                "type": "boolean",
                "description": "第一列是否作为图例，其他列默认为false"
              },
              "function": {
                "type": "string",
                "description": "映射函数类型，例如 \"objCol\" 表示对象列，\"vCol\"表示数值列"
              },
              "configurable": {
                "type": "boolean",
                "description": "图表是否绘制这一列数值"
              },
              "xAxisIndex": {
                "type": "number",
                "description": "对应的X轴索引"
              },
              "yAxisIndex": {
                "type": "number",
                "description": "对应的Y轴索引"
              },
              "type": {
                "type": "string",
                "description": "图表中绘制的元素类型，对于柱状图通常为 'bar' (or 'column')",
                "enum": [
                  "bar"
                ]
              }
            },
            "required": [
              "name",
              "index",
              "isLegend",
              "function",
              "configurable",
              "type"
            ],
            "oneOf": [
              {
                "description": "Must have xAxisIndex and not yAxisIndex.",
                "required": [
                  "xAxisIndex"
                ],
                "properties": {
                  "yAxisIndex": false
                }
              },
              {
                "description": "Must have yAxisIndex and not xAxisIndex.",
                "required": [
                  "yAxisIndex"
                ],
                "properties": {
                  "xAxisIndex": false
                }
              }
            ]
          }
        },
        "fill": {
          "type": "object",
          "description": "填充配置，定义图表元素的颜色、纹理、阴影和边框",
          "properties": {
            "controlType": {
              "type": "string",
              "enum": [
                "single",
                "multiple",
                "gradient"
              ],
              "description": "填充控制类型"
            },
            "props": {
              "type": "array",
              "description": "填充属性数组，每个对象定义一种填充方式",
              "items": {
                "type": "object",
                "properties": {
                  "color": {
                    "$ref": "commonChartDefinitions.json#/definitions/colorOption"
                  },
                  "shadow": {
                    "type": "object",
                    "description": "阴影配置（可选）",
                    "properties": {
                      "show": {
                        "type": "boolean",
                        "default": false
                      },
                      "type": {
                        "type": "string",
                        "enum": [
                          "outer",
                          "inner"
                        ],
                        "default": "outer"
                      },
                      "angle": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 360,
                        "default": 45
                      },
                      "blur": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 100,
                        "default": 5
                      },
                      "color": {
                        "$ref": "commonChartDefinitions.json#/definitions/simpleColor",
                        "default": {
                          "color": "#000000",
                          "opacity": 0.3
                        }
                      },
                      "radius": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 100,
                        "default": 5
                      }
                    }
                  },
                  "border": {
                    "type": "object",
                    "description": "边框配置（可选），用于堆叠柱的段与段之间的分隔",
                    "properties": {
                      "type": {
                        "type": "string",
                        "enum": [
                          "solid",
                          "dashed",
                          "dotted"
                        ],
                        "default": "solid"
                      },
                      "width": {
                        "type": "number",
                        "default": 0,
                        "description": "e.g., 1 or 2 for segment separation"
                      },
                      "color": {
                        "$ref": "commonChartDefinitions.json#/definitions/borderElementColorOption"
                      }
                    }
                  }
                },
                "required": [
                  "color",
                  "shadow",
                  "border"
                ]
              }
            }
          },
          "required": [
            "controlType",
            "props"
          ]
        },
        "display": {
          "type": "object",
          "description": "显示配置，定义图表元素的显示属性",
          "properties": {
            "bar": {
              "type": "object",
              "description": "柱状图特定显示属性",
              "properties": {
                "widthPercent": {
                  "type": "number",
                  "description": "柱状图宽度占比（相对于分类的可用宽度）",
                  "default": 0.6,
                  "minimum": 0.01,
                  "maximum": 1
                },
                "border": {
                  "type": "object",
                  "description": "柱状图外边框配置 (整个堆叠柱的边框, 非段间)",
                  "properties": {
                    "radius": {
                      "oneOf": [
                        {
                          "type": "number"
                        },
                        {
                          "type": "array",
                          "items": {
                            "type": "number"
                          },
                          "minItems": 4,
                          "maxItems": 4
                        }
                      ],
                      "default": 0
                    },
                    "type": {
                      "type": "string",
                      "enum": [
                        "solid",
                        "dashed",
                        "dotted"
                      ],
                      "default": "solid"
                    },
                    "width": {
                      "type": "number",
                      "default": 0
                    },
                    "color": {
                      "$ref": "commonChartDefinitions.json#/definitions/borderElementColorOption"
                    }
                  },
                  "required": [
                    "radius",
                    "type",
                    "width"
                  ]
                }
              },
              "required": [
                "widthPercent",
                "border"
              ]
            }
          },
          "required": [
            "bar"
          ]
        },
        "legend": {
          "$ref": "commonChartDefinitions.json#/definitions/legendConfig"
        },
        "label": {
          "type": "object",
          "description": "标签配置",
          "properties": {
            "show": {
              "type": "boolean",
              "default": false
            },
            "barLabel": {
              "type": "object",
              "description": "柱状图标签配置 (用于堆叠柱的各分段)",
              "properties": {
                "show": {
                  "type": "boolean",
                  "default": false
                },
                "positionChoice": {
                  "type": "string",
                  "enum": [
                    "top",
                    "center",
                    "bottom"
                  ],
                  "default": "center",
                  "description": "标签位置选择 (for stacked column segments)"
                },
                "fontFamily": {
                  "type": "string",
                  "default": "Misans 常规"
                },
                "fontSize": {
                  "type": "number",
                  "default": 12
                },
                "color": {
                  "$ref": "commonChartDefinitions.json#/definitions/simpleColor",
                  "default": {
                    "color": "#000000",
                    "opacity": 1
                  }
                },
                "suffix": {
                  "type": "string",
                  "default": ""
                }
              },
              "required": [
                "show",
                "positionChoice",
                "fontFamily",
                "fontSize",
                "color",
                "suffix"
              ]
            },
            "highlight": {
              "type": "boolean",
              "default": false
            },
            "overlap": {
              "type": "boolean",
              "default": false
            }
          },
          "required": [
            "show",
            "barLabel",
            "highlight",
            "overlap"
          ]
        },
        "axis": {
          "type": "object",
          "description": "坐标轴配置",
          "properties": {
            "show": {
              "type": "boolean",
              "default": true
            },
            "xAxis": {
              "type": "array",
              "description": "X轴配置数组",
              "items": {
                "type": "object",
                "properties": {
                  "line": {
                    "type": "object",
                    "properties": {
                      "show": {
                        "type": "boolean",
                        "default": true
                      },
                      "width": {
                        "type": "number",
                        "default": 1
                      },
                      "color": {
                        "$ref": "commonChartDefinitions.json#/definitions/simpleColor",
                        "default": {
                          "color": "#000000",
                          "opacity": 1
                        }
                      }
                    },
                    "required": [
                      "show",
                      "width",
                      "color"
                    ]
                  },
                  "label": {
                    "type": "object",
                    "properties": {
                      "show": {
                        "type": "boolean",
                        "default": true
                      },
                      "direction": {
                        "type": "string",
                        "enum": [
                          "horizontal",
                          "auto"
                        ],
                        "default": "auto"
                      },
                      "fontFamily": {
                        "type": "string",
                        "default": "Misans 常规"
                      },
                      "fontSize": {
                        "type": "number",
                        "default": 12
                      },
                      "color": {
                        "$ref": "commonChartDefinitions.json#/definitions/simpleColor",
                        "default": {
                          "color": "#000000",
                          "opacity": 1
                        }
                      },
                      "angle": {
                        "type": "number",
                        "default": 0
                      }
                    },
                    "required": [
                      "show",
                      "direction",
                      "fontFamily",
                      "fontSize",
                      "color",
                      "angle"
                    ]
                  },
                  "grid": {
                    "type": "object",
                    "properties": {
                      "show": {
                        "type": "boolean",
                        "default": false
                      },
                      "width": {
                        "type": "number",
                        "default": 1
                      },
                      "color": {
                        "$ref": "commonChartDefinitions.json#/definitions/simpleColor",
                        "default": {
                          "color": "#cccccc",
                          "opacity": 1
                        }
                      },
                      "type": {
                        "type": "string",
                        "enum": [
                          "solid",
                          "dashed",
                          "dotted"
                        ],
                        "default": "solid"
                      }
                    },
                    "required": [
                      "show",
                      "width",
                      "color",
                      "type"
                    ]
                  },
                  "position": {
                    "type": "string",
                    "enum": [
                      "top",
                      "bottom"
                    ],
                    "default": "bottom"
                  },
                  "type": {
                    "type": "string",
                    "enum": [
                      "value",
                      "category",
                      "time",
                      "log"
                    ],
                    "default": "category"
                  }
                },
                "required": [
                  "line",
                  "label",
                  "grid",
                  "position",
                  "type"
                ]
              },
              "minItems": 1
            },
            "yAxis": {
              "type": "array",
              "description": "Y轴配置数组",
              "items": {
                "type": "object",
                "properties": {
                  "line": {
                    "type": "object",
                    "properties": {
                      "show": {
                        "type": "boolean",
                        "default": true
                      },
                      "width": {
                        "type": "number",
                        "default": 1
                      },
                      "color": {
                        "$ref": "commonChartDefinitions.json#/definitions/simpleColor",
                        "default": {
                          "color": "#000000",
                          "opacity": 1
                        }
                      }
                    },
                    "required": [
                      "show",
                      "width",
                      "color"
                    ]
                  },
                  "label": {
                    "type": "object",
                    "properties": {
                      "show": {
                        "type": "boolean",
                        "default": true
                      },
                      "fontFamily": {
                        "type": "string",
                        "default": "Misans 常规"
                      },
                      "fontSize": {
                        "type": "number",
                        "default": 12
                      },
                      "color": {
                        "$ref": "commonChartDefinitions.json#/definitions/simpleColor",
                        "default": {
                          "color": "#000000",
                          "opacity": 1
                        }
                      },
                      "angle": {
                        "type": "number",
                        "default": 0
                      },
                      "suffix": {
                        "type": "string",
                        "default": ""
                      }
                    },
                    "required": [
                      "show",
                      "fontFamily",
                      "fontSize",
                      "color",
                      "angle",
                      "suffix"
                    ]
                  },
                  "grid": {
                    "type": "object",
                    "properties": {
                      "show": {
                        "type": "boolean",
                        "default": true
                      },
                      "width": {
                        "type": "number",
                        "default": 1
                      },
                      "color": {
                        "$ref": "commonChartDefinitions.json#/definitions/simpleColor",
                        "default": {
                          "color": "#cccccc",
                          "opacity": 1
                        }
                      },
                      "type": {
                        "type": "string",
                        "enum": [
                          "solid",
                          "dashed",
                          "dotted"
                        ],
                        "default": "solid"
                      }
                    },
                    "required": [
                      "show",
                      "width",
                      "color",
                      "type"
                    ]
                  },
                  "position": {
                    "type": "string",
                    "enum": [
                      "left",
                      "right"
                    ],
                    "default": "left"
                  },
                  "type": {
                    "type": "string",
                    "enum": [
                      "value",
                      "category",
                      "time",
                      "log"
                    ],
                    "default": "value"
                  },
                  "stepOfLabel": {
                    "oneOf": [
                      {
                        "type": "number"
                      },
                      {
                        "type": "string",
                        "enum": [
                          "auto"
                        ]
                      }
                    ],
                    "default": "auto"
                  },
                  "range": {
                    "type": "array",
                    "items": {
                      "type": "number"
                    },
                    "default": [],
                    "description": "坐标轴范围 [min, max]"
                  }
                },
                "required": [
                  "line",
                  "label",
                  "grid",
                  "position",
                  "type",
                  "stepOfLabel"
                ]
              },
              "minItems": 1
            }
          },
          "required": [
            "show",
            "xAxis",
            "yAxis"
          ]
        },
        "numberFormat": {
          "$ref": "commonChartDefinitions.json#/definitions/numberFormatConfig"
        },
        "animation": {
          "$ref": "commonChartDefinitions.json#/definitions/animationConfig"
        },
        "tooltip": {
          "$ref": "commonChartDefinitions.json#/definitions/tooltipConfig"
        },
        "padding": {
          "$ref": "commonChartDefinitions.json#/definitions/paddingConfig"
        }
      },
      "required": [
        "type",
        "title",
        "background",
        "map",
        "fill",
        "display",
        "legend",
        "label",
        "axis",
        "numberFormat",
        "animation",
        "tooltip",
        "padding"
      ]
    }
  },
  "required": [
    "data",
    "pipe",
    "props"
  ]
}