{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.com/schemas/funnelChartSchema.json",
  "title": "Funnel Chart Configuration",
  "description": "Schema for configuring a funnel chart.",
  "type": "object",
  "properties": {
    "data": {
      "$ref": "commonChartDefinitions.json#/definitions/chartDataArray"
    },
    "pipe": {
      "type": "string",
      "default": "key_value",
      "description": "数据处理方式，例如 \"key_value\""
    },
    "props": {
      "type": "object",
      "description": "图表的配置项",
      "properties": {
        "type": {
          "type": "string",
          "const": "funnel",
          "description": "图表类型固定为漏斗图"
        },
        "title": {
          "$ref": "commonChartDefinitions.json#/definitions/titleConfig"
        },
        "background": {
          "$ref": "commonChartDefinitions.json#/definitions/backgroundConfig"
        },
        "map": {
          "type": "array",
          "description": "数据映射配置 (通常两项: 阶段名称和值)",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "description": "映射名称, e.g., '名称' or '值'"
              },
              "index": {
                "type": "number",
                "description": "数据列索引"
              },
              "isLegend": {
                "type": "boolean",
                "default": true,
                "description": "第一列是否作为图例，其他列默认为false"
              },
              "function": {
                "type": "string",
                "description": "映射函数类型 (e.g., 'objCol' for name, 'vCol' for value)"
              },
              "configurable": {
                "type": "boolean",
                "description": "图表是否绘制这一列数值"
              },
              "type": {
                "type": "string",
                "description": "图表中绘制的元素类型 (funnel segment)",
                "enum": [
                  "bar"
                ]
              }
            },
            "required": [
              "name",
              "index",
              "isLegend",
              "function",
              "configurable",
              "type"
            ]
          },
          "minItems": 2,
          "maxItems": 2
        },
        "fill": {
          "type": "object",
          "description": "漏斗图分段颜色配置",
          "properties": {
            "controlType": {
              "type": "string",
              "enum": [
                "single",
                "multiple",
                "gradient"
              ],
              "default": "multiple"
            },
            "props": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "color": {
                    "$ref": "commonChartDefinitions.json#/definitions/colorOption"
                  },
                  "shadow": {
                    "type": "object",
                    "properties": {
                      "show": {
                        "type": "boolean",
                        "default": false
                      },
                      "type": {
                        "type": "string",
                        "enum": [
                          "outer",
                          "inner"
                        ],
                        "default": "outer"
                      },
                      "angle": {
                        "type": "number",
                        "default": 45
                      },
                      "blur": {
                        "type": "number",
                        "default": 3
                      },
                      "color": {
                        "$ref": "commonChartDefinitions.json#/definitions/simpleColor",
                        "default": {
                          "color": "#000000",
                          "opacity": 0.2
                        }
                      },
                      "radius": {
                        "type": "number",
                        "default": 2
                      }
                    }
                  },
                  "border": {
                    "type": "object",
                    "properties": {
                      "type": {
                        "type": "string",
                        "enum": [
                          "solid",
                          "dashed",
                          "dotted"
                        ],
                        "default": "solid"
                      },
                      "width": {
                        "type": "number",
                        "default": 0
                      },
                      "color": {
                        "$ref": "commonChartDefinitions.json#/definitions/borderElementColorOption"
                      }
                    }
                  }
                },
                "required": [
                  "color",
                  "shadow",
                  "border"
                ]
              }
            }
          },
          "required": [
            "controlType",
            "props"
          ]
        },
        "display": {
          "type": "object",
          "description": "显示配置，定义漏斗图元素的显示属性",
          "properties": {
            "bar": {
              "type": "object",
              "description": "漏斗图分段显示属性",
              "properties": {
                "gapDistance": {
                  "type": "number",
                  "default": 0,
                  "minimum": 0,
                  "description": "漏斗（梯形）上下之间的间隙"
                },
                "fillOpacity": {
                  "type": "number",
                  "default": 1,
                  "minimum": 0,
                  "maximum": 1,
                  "description": "漏斗整体填充不透明度"
                },
                "border": {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "enum": [
                        "solid",
                        "dashed",
                        "dotted"
                      ],
                      "default": "solid"
                    },
                    "width": {
                      "type": "number",
                      "default": 0
                    },
                    "color": {
                      "$ref": "commonChartDefinitions.json#/definitions/borderElementColorOption"
                    }
                  },
                  "required": [
                    "type",
                    "width"
                  ]
                }
              },
              "required": [
                "gapDistance",
                "fillOpacity",
                "border"
              ]
            }
          },
          "required": [
            "bar"
          ]
        },
        "legend": {
          "$ref": "commonChartDefinitions.json#/definitions/legendConfig"
        },
        "label": {
          "type": "object",
          "description": "标签配置",
          "properties": {
            "show": {
              "type": "boolean",
              "default": true,
              "description": "是否显示所有标签（总开关）"
            },
            "textLabel": {
              "type": "object",
              "description": "漏斗文字标签 (阶段名称)",
              "properties": {
                "show": {
                  "type": "boolean",
                  "default": true
                },
                "positionChoice": {
                  "type": "string",
                  "enum": [
                    "inside-horizontal",
                    "outside-edge",
                    "outside-follow"
                  ],
                  "default": "inside-horizontal"
                },
                "fontFamily": {
                  "type": "string",
                  "default": "Misans 常规"
                },
                "fontSize": {
                  "type": "number",
                  "default": 14
                },
                "color": {
                  "$ref": "commonChartDefinitions.json#/definitions/simpleColor",
                  "default": {
                    "color": "#000000",
                    "opacity": 1
                  }
                }
              },
              "required": [
                "show",
                "positionChoice",
                "fontFamily",
                "fontSize",
                "color"
              ]
            },
            "numberLabel": {
              "type": "object",
              "description": "漏斗数值标签",
              "properties": {
                "show": {
                  "type": "boolean",
                  "default": true
                },
                "positionChoice": {
                  "type": "string",
                  "enum": [
                    "inside-horizontal",
                    "outside-edge",
                    "outside-follow"
                  ],
                  "default": "inside-horizontal"
                },
                "fontFamily": {
                  "type": "string",
                  "default": "Misans 常规"
                },
                "fontSize": {
                  "type": "number",
                  "default": 12
                },
                "color": {
                  "$ref": "commonChartDefinitions.json#/definitions/simpleColor",
                  "default": {
                    "color": "#000000",
                    "opacity": 1
                  }
                },
                "suffix": {
                  "type": "string",
                  "default": ""
                }
              },
              "required": [
                "show",
                "positionChoice",
                "fontFamily",
                "fontSize",
                "color",
                "suffix"
              ]
            },
            "percentLabel": {
              "type": "object",
              "description": "漏斗百分比标签 (e.g., conversion rate)",
              "properties": {
                "show": {
                  "type": "boolean",
                  "default": false
                },
                "positionChoice": {
                  "type": "string",
                  "enum": [
                    "inside-horizontal",
                    "outside-edge",
                    "outside-follow"
                  ],
                  "default": "outside-follow"
                },
                "fontFamily": {
                  "type": "string",
                  "default": "Misans 常规"
                },
                "fontSize": {
                  "type": "number",
                  "default": 10
                },
                "color": {
                  "$ref": "commonChartDefinitions.json#/definitions/simpleColor",
                  "default": {
                    "color": "#000000",
                    "opacity": 1
                  }
                }
              },
              "required": [
                "show",
                "positionChoice",
                "fontFamily",
                "fontSize",
                "color"
              ]
            },
            "highlight": {
              "type": "boolean",
              "default": false
            },
            "overlap": {
              "type": "boolean",
              "default": false
            }
          },
          "required": [
            "show",
            "textLabel",
            "numberLabel",
            "percentLabel",
            "highlight",
            "overlap"
          ]
        },
        "numberFormat": {
          "$ref": "commonChartDefinitions.json#/definitions/numberFormatConfig"
        },
        "animation": {
          "$ref": "commonChartDefinitions.json#/definitions/animationConfig"
        },
        "tooltip": {
          "$ref": "commonChartDefinitions.json#/definitions/tooltipConfig"
        },
        "padding": {
          "$ref": "commonChartDefinitions.json#/definitions/paddingConfig"
        }
      },
      "required": [
        "type",
        "title",
        "background",
        "map",
        "fill",
        "display",
        "legend",
        "label",
        "numberFormat",
        "animation",
        "tooltip",
        "padding"
      ]
    }
  },
  "required": [
    "data",
    "pipe",
    "props"
  ]
}