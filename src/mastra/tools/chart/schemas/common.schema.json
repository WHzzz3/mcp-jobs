
{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "https://example.com/schemas/commonChartDefinitions.json",
    "title": "Common Chart Definitions",
    "description": "Reusable schema definitions for various chart types.",
    "definitions": {
      "simpleColor": {
        "type": "object",
        "description": "简单颜色对象",
        "properties": {
          "color": { "type": "string", "description": "颜色代码 (e.g., #000000)" },
          "opacity": { "type": "number", "minimum": 0, "maximum": 1, "description": "透明度 (0-1)" }
        },
        "required": ["color", "opacity"]
      },
      "gradientColor": {
        "type": "object",
        "description": "渐变颜色对象",
        "properties": {
          "type": { "type": "string", "enum": ["linear"], "description": "渐变类型" },
          "angle": { "type": "number", "minimum": 0, "maximum": 360, "description": "渐变角度 (0-360 for linear)" },
          "colorStops": {
            "type": "array",
            "description": "渐变色标点",
            "items": {
              "type": "object",
              "properties": {
                "color": { "type": "string", "description": "颜色代码" },
                "opacity": { "type": "number", "minimum": 0, "maximum": 1, "description": "透明度" },
                "offset": { "type": "number", "minimum": 0, "maximum": 1, "description": "渐变停止点 (0-1)" }
              },
              "required": ["color", "opacity", "offset"]
            }
          },
          "opacity": { "type": "number", "minimum": 0, "maximum": 1, "description": "整体渐变透明度 (0-1)" }
        },
        "required": ["type", "colorStops", "opacity"]
      },
      "colorOption": {
        "description": "颜色选项，可以是简单颜色或渐变颜色",
        "oneOf": [
          { "$ref": "#/definitions/simpleColor" },
          { "$ref": "#/definitions/gradientColor" }
        ]
      },
      "borderElementColorOption": {
          "description": "边框颜色选项，可以是简单颜色、渐变颜色或null（自动，通常表示与填充色一致）",
          "oneOf": [
              { "$ref": "#/definitions/simpleColor" },
              { "$ref": "#/definitions/gradientColor" },
              { "type": "null" }
          ]
      },
      "positionXY": {
          "type": "object",
          "description": "XY轴向的位置配置 (left/center/right, top/center/bottom)",
          "properties": {
              "x": { "type": "string", "enum": ["left", "center", "right"], "description": "水平位置" },
              "y": { "type": "string", "enum": ["top", "center", "bottom"], "description": "垂直位置" }
          },
          "required": ["x", "y"]
      },
      "chartDataArray": {
        "type": "array",
        "description": "图表源数据，通常是三维数组，包含字符串或数字。例如: [ [['维度名', '系列1', '系列2'], ['X轴分类1', 100, 200]] ]",
        "items": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "oneOf": [
                { "type": "string" },
                { "type": "number" }
              ]
            }
          }
        }
      },
      "titleConfig": {
        "type": "object",
        "description": "图表标题配置",
        "properties": {
          "show": { "type": "boolean", "default": true, "description": "是否显示标题" },
          "mainTitle": {
            "type": "object",
            "properties": {
              "show": { "type": "boolean", "default": true, "description": "是否显示主标题" },
              "text": { "type": "string", "description": "主标题文本内容" },
              "fontFamily": { "type": "string", "default": "Misans 常规", "description": "主标题的字体族" },
              "fontSize": { "type": "number", "default": 24, "description": "主标题的字体大小" },
              "color": { "$ref": "#/definitions/simpleColor", "default": {"color": "#333333", "opacity": 1} },
              "position": { "$ref": "#/definitions/positionXY", "default": {"x": "center", "y": "top"} }
            },
            "required": ["show", "text", "fontFamily", "fontSize", "color", "position"]
          },
          "subTitle": {
            "type": "object",
            "properties": {
              "show": { "type": "boolean", "default": false, "description": "是否显示副标题" },
              "text": { "type": "string", "description": "副标题文本内容" },
              "fontSize": { "type": "number", "default": 16, "description": "副标题的字体大小" },
              "color": { "$ref": "#/definitions/simpleColor", "default": {"color": "#666666", "opacity": 1} },
              "fontFamily": { "type": "string", "default": "Misans 常规", "description": "副标题的字体族" }
            },
            "required": ["show", "text", "fontFamily", "fontSize", "color"]
          }
        }
      },
      "backgroundConfig": {
        "type": "object",
        "description": "图表背景配置",
        "properties": {
          "show": { "type": "boolean", "default": false, "description": "是否显示背景" },
          "color": { "$ref": "#/definitions/colorOption", "description": "背景颜色或渐变" },
          "border": {
            "type": "object",
            "properties": {
              "radius": {
                "oneOf": [
                  { "type": "number", "description": "统一圆角值" },
                  { "type": "array", "items": { "type": "number" }, "minItems": 4, "maxItems": 4, "description": "分别指定四个角的圆角 [topLeft, topRight, bottomRight, bottomLeft]" }
                ],
                "default": 0,
                "description": "边框圆角"
              }
            }
          },
          "blur": { "type": "number", "default": 0, "description": "背景模糊程度" }
        }
      },
      "legendConfig": {
        "type": "object",
        "description": "图例配置",
        "properties": {
          "show": { "type": "boolean", "default": true, "description": "是否显示图例" },
          "display": { "type": "string", "enum": ["horizontal", "vertical"], "default": "horizontal", "description": "图例排列方式" },
          "position": { "$ref": "#/definitions/positionXY", "default": {"x": "center", "y": "bottom"} },
          "fontFamily": { "type": "string", "default": "Misans 常规", "description": "图例字体族" },
          "fontSize": { "type": "number", "default": 14, "description": "图例字体大小" },
          "color": { "$ref": "#/definitions/simpleColor", "default": {"color": "#333333", "opacity": 1} }
        }
      },
      "numberFormatConfig": {
        "type": "object",
        "description": "数字格式化配置",
        "properties": {
          "separatorType": {
            "type": "string",
            "enum": ["1000.00", "1|000.00", "1000|00", "1.000|00", "1 000.00", "1 000|00"],
            "default": "1000.00",
            "description": "千位分隔符类型"
          },
          "decimalPlaces": {
            "oneOf": [
              { "type": "number", "description": "固定小数位数" },
              { "type": "null", "description": "不限制小数位数（自动）" }
            ],
            "default": null,
            "description": "小数位数"
          }
        }
      },
      "animationConfig": {
        "type": "object",
        "description": "图表动画配置",
        "properties": {
          "show": { "type": "boolean", "default": false, "description": "是否启用入场动画或更新动画，默认不启用" },
          "transition": { "type": "boolean", "default": false, "description": "是否开启动画过渡效果（针对数据更新时的平滑过渡），默认不开启" },
          "moveStyle": {
            "oneOf": [
              { "type": "string", "description": "预设动画效果名称" },
              { "type": "null", "description": "无动画效果" }
            ],
            "default": null,
            "description": "动画类型或样式，默认无动画"
          },
          "duration": { "type": "number", "default": 2, "description": "动画持续时间（秒）" },
          "startDelay": { "type": "number", "default": 0, "description": "动画开始延迟时间（秒）" },
          "endPause": { "type": "number", "default": 0, "description": "动画结束后的暂停时间（秒）, 主要用于系列动画" },
          "loop": { "type": "boolean", "default": false, "description": "是否循环播放动画（特定场景）" }
        }
      },
      "tooltipConfig": {
        "type": "boolean",
        "default": true,
        "description": "是否启用工具提示（鼠标悬浮提示）"
      },
      "paddingConfig": {
        "type": "object",
        "description": "图表内边距配置 (图表绘图区域与容器边缘的距离)",
        "properties": {
          "top": { "type": "number", "default": 20, "description": "上边距" },
          "bottom": { "type": "number", "default": 20, "description": "下边距" },
          "left": { "type": "number", "default": 20, "description": "左边距" },
          "right": { "type": "number", "default": 20, "description": "右边距" }
        }
      }
    }
  }