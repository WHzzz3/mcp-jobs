{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.com/schemas/mixedLineGroupedColumnChartSchema.json",
  "title": "Mixed Line + Grouped Column Chart Configuration",
  "description": "Schema for configuring a mixed line and grouped column chart, with fully inlined axis configurations.",
  "type": "object",
  "properties": {
    "data": {
      "$ref": "commonChartDefinitions.json#/definitions/chartDataArray"
    },
    "pipe": {
      "type": "string",
      "default": "cross",
      "description": "数据处理方式，用于图表绘制时的数据转换或处理流程，例如 \"cross\""
    },
    "props": {
      "type": "object",
      "description": "图表的配置项",
      "properties": {
        "type": {
          "type": "string",
          "const": "mixed-line-grouped-column",
          "description": "图表类型固定为折线+分组柱状混合图"
        },
        "title": {
          "$ref": "commonChartDefinitions.json#/definitions/titleConfig"
        },
        "background": {
          "$ref": "commonChartDefinitions.json#/definitions/backgroundConfig"
        },
        "map": {
          "type": "array",
          "description": "数据映射配置，定义数据列如何映射到图表的各个部分 (line or bar)",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "description": "映射名称，例如 \"X轴对象\"或者\"数值列\""
              },
              "index": {
                "type": "number",
                "description": "数据列索引"
              },
              "isLegend": {
                "type": "boolean",
                "description": "第一列是否作为图例，其他列默认为false"
              },
              "function": {
                "type": "string",
                "description": "映射函数类型，例如 \"objCol\" 表示对象列，\"vCol\"表示数值列"
              },
              "configurable": {
                "type": "boolean",
                "description": "图表是否绘制这一列数值"
              },
              "xAxisIndex": {
                "type": "number",
                "default": 0,
                "description": "对应的X轴索引 (通常为0)"
              },
              "yAxisIndex": {
                "type": "number",
                "default": 0,
                "description": "对应的Y轴索引 (0 for left, 1 for right usually)"
              },
              "type": {
                "type": "string",
                "description": "图表中绘制的元素类型",
                "enum": [
                  "bar",
                  "line"
                ]
              }
            },
            "required": [
              "name",
              "index",
              "isLegend",
              "function",
              "configurable",
              "type"
            ],
            "oneOf": [
              {
                "description": "Must have xAxisIndex and not yAxisIndex.",
                "required": [
                  "xAxisIndex"
                ],
                "properties": {
                  "yAxisIndex": false
                }
              },
              {
                "description": "Must have yAxisIndex and not xAxisIndex.",
                "required": [
                  "yAxisIndex"
                ],
                "properties": {
                  "xAxisIndex": false
                }
              }
            ]
          }
        },
        "fill": {
          "type": "object",
          "description": "系列（线条或柱子）颜色配置",
          "properties": {
            "controlType": {
              "type": "string",
              "enum": [
                "single",
                "multiple",
                "gradient"
              ]
            },
            "props": {
              "type": "array",
              "description": "颜色属性数组, 对应每个系列",
              "items": {
                "type": "object",
                "properties": {
                  "color": {
                    "$ref": "commonChartDefinitions.json#/definitions/colorOption"
                  },
                  "shadow": {
                    "type": "object",
                    "properties": {
                      "show": {
                        "type": "boolean",
                        "default": false
                      },
                      "type": {
                        "type": "string",
                        "enum": [
                          "outer",
                          "inner"
                        ],
                        "default": "outer"
                      },
                      "angle": {
                        "type": "number",
                        "default": 45
                      },
                      "blur": {
                        "type": "number",
                        "default": 5
                      },
                      "color": {
                        "$ref": "commonChartDefinitions.json#/definitions/simpleColor",
                        "default": {
                          "color": "#000000",
                          "opacity": 0.3
                        }
                      },
                      "radius": {
                        "type": "number",
                        "default": 3
                      }
                    }
                  },
                  "border": {
                    "type": "object",
                    "properties": {
                      "type": {
                        "type": "string",
                        "enum": [
                          "solid",
                          "dashed",
                          "dotted"
                        ],
                        "default": "solid"
                      },
                      "width": {
                        "type": "number",
                        "default": 0
                      },
                      "color": {
                        "$ref": "commonChartDefinitions.json#/definitions/borderElementColorOption"
                      }
                    }
                  }
                },
                "required": [
                  "color",
                  "shadow"
                ]
              }
            }
          },
          "required": [
            "controlType",
            "props"
          ]
        },
        "display": {
          "type": "object",
          "description": "显示配置，包含线条和柱子的全局显示属性",
          "properties": {
            "line": {
              "type": "object",
              "description": "折线图全局显示属性",
              "properties": {
                "type": {
                  "type": "string",
                  "enum": [
                    "straight",
                    "curve"
                  ],
                  "default": "straight"
                },
                "width": {
                  "type": "number",
                  "default": 2,
                  "minimum": 0
                },
                "endPoint": {
                  "type": "object",
                  "properties": {
                    "radius": {
                      "type": "number",
                      "default": 3,
                      "minimum": 0
                    },
                    "width": {
                      "type": "number",
                      "default": 1,
                      "minimum": 0
                    },
                    "color": {
                      "$ref": "commonChartDefinitions.json#/definitions/borderElementColorOption"
                    },
                    "fill": {
                      "$ref": "commonChartDefinitions.json#/definitions/borderElementColorOption"
                    }
                  },
                  "required": [
                    "radius",
                    "width",
                    "color",
                    "fill"
                  ]
                }
              },
              "required": [
                "type",
                "width",
                "endPoint"
              ]
            },
            "bar": {
              "type": "object",
              "description": "柱状图全局显示属性",
              "properties": {
                "widthPercent": {
                  "type": "number",
                  "default": 0.6,
                  "minimum": 0.01,
                  "maximum": 1
                },
                "border": {
                  "type": "object",
                  "properties": {
                    "radius": {
                      "oneOf": [
                        {
                          "type": "number"
                        },
                        {
                          "type": "array",
                          "items": {
                            "type": "number"
                          },
                          "minItems": 4,
                          "maxItems": 4
                        }
                      ],
                      "default": 0
                    },
                    "type": {
                      "type": "string",
                      "enum": [
                        "solid",
                        "dashed",
                        "dotted"
                      ],
                      "default": "solid"
                    },
                    "width": {
                      "type": "number",
                      "default": 0
                    },
                    "color": {
                      "$ref": "commonChartDefinitions.json#/definitions/borderElementColorOption"
                    }
                  },
                  "required": [
                    "radius",
                    "type",
                    "width"
                  ]
                }
              },
              "required": [
                "widthPercent",
                "border"
              ]
            }
          },
          "required": [
            "line",
            "bar"
          ]
        },
        "legend": {
          "$ref": "commonChartDefinitions.json#/definitions/legendConfig"
        },
        "label": {
          "type": "object",
          "description": "标签配置, 包含柱状图和折线图标签",
          "properties": {
            "show": {
              "type": "boolean",
              "default": false,
              "description": "是否显示所有标签（总开关）"
            },
            "barLabel": {
              "type": "object",
              "properties": {
                "show": {
                  "type": "boolean",
                  "default": false
                },
                "positionChoice": {
                  "type": "string",
                  "enum": [
                    "outside",
                    "top",
                    "center",
                    "bottom"
                  ],
                  "default": "top"
                },
                "fontFamily": {
                  "type": "string",
                  "default": "Misans 常规"
                },
                "fontSize": {
                  "type": "number",
                  "default": 12
                },
                "color": {
                  "$ref": "commonChartDefinitions.json#/definitions/simpleColor",
                  "default": {
                    "color": "#000000",
                    "opacity": 1
                  }
                },
                "suffix": {
                  "type": "string",
                  "default": ""
                }
              },
              "required": [
                "show",
                "positionChoice",
                "fontFamily",
                "fontSize",
                "color",
                "suffix"
              ]
            },
            "lineLabel": {
              "type": "object",
              "properties": {
                "show": {
                  "type": "boolean",
                  "default": false
                },
                "positionChoice": {
                  "type": "string",
                  "enum": [
                    "top",
                    "bottom"
                  ],
                  "default": "top"
                },
                "fontFamily": {
                  "type": "string",
                  "default": "Misans 常规"
                },
                "fontSize": {
                  "type": "number",
                  "default": 12
                },
                "color": {
                  "$ref": "commonChartDefinitions.json#/definitions/simpleColor",
                  "default": {
                    "color": "#000000",
                    "opacity": 1
                  }
                },
                "suffix": {
                  "type": "string",
                  "default": ""
                }
              },
              "required": [
                "show",
                "positionChoice",
                "fontFamily",
                "fontSize",
                "color",
                "suffix"
              ]
            },
            "highlight": {
              "type": "boolean",
              "default": false
            },
            "overlap": {
              "type": "boolean",
              "default": false
            }
          },
          "required": [
            "show",
            "barLabel",
            "lineLabel",
            "highlight",
            "overlap"
          ]
        },
        "axis": {
          "type": "object",
          "description": "坐标轴配置",
          "properties": {
            "show": {
              "type": "boolean",
              "default": true
            },
            "xAxis": {
              "type": "array",
              "description": "X轴配置数组",
              "items": {
                "type": "object",
                "description": "X轴配置单元",
                "properties": {
                  "line": {
                    "type": "object",
                    "description": "坐标轴线配置",
                    "properties": {
                      "show": {
                        "type": "boolean",
                        "default": true,
                        "description": "是否显示坐标轴线"
                      },
                      "width": {
                        "type": "number",
                        "default": 1,
                        "description": "坐标轴线宽度"
                      },
                      "color": {
                        "$ref": "commonChartDefinitions.json#/definitions/simpleColor",
                        "default": {
                          "color": "#000000",
                          "opacity": 1
                        },
                        "description": "坐标轴线颜色"
                      }
                    },
                    "required": [
                      "show",
                      "width",
                      "color"
                    ]
                  },
                  "label": {
                    "type": "object",
                    "description": "坐标轴标签配置",
                    "properties": {
                      "show": {
                        "type": "boolean",
                        "default": true,
                        "description": "是否显示坐标轴标签"
                      },
                      "direction": {
                        "type": "string",
                        "enum": [
                          "horizontal",
                          "auto"
                        ],
                        "default": "auto",
                        "description": "标签方向"
                      },
                      "fontFamily": {
                        "type": "string",
                        "default": "Misans 常规",
                        "description": "标签字体族"
                      },
                      "fontSize": {
                        "type": "number",
                        "default": 12,
                        "description": "标签字体大小"
                      },
                      "color": {
                        "$ref": "commonChartDefinitions.json#/definitions/simpleColor",
                        "default": {
                          "color": "#000000",
                          "opacity": 1
                        },
                        "description": "标签颜色"
                      },
                      "angle": {
                        "type": "number",
                        "default": 0,
                        "description": "标签旋转角度"
                      }
                    },
                    "required": [
                      "show",
                      "fontFamily",
                      "fontSize",
                      "color",
                      "angle",
                      "direction"
                    ]
                  },
                  "grid": {
                    "type": "object",
                    "description": "坐标轴网格线配置",
                    "properties": {
                      "show": {
                        "type": "boolean",
                        "default": false,
                        "description": "是否显示网格线"
                      },
                      "width": {
                        "type": "number",
                        "default": 1,
                        "description": "网格线宽度"
                      },
                      "color": {
                        "$ref": "commonChartDefinitions.json#/definitions/simpleColor",
                        "default": {
                          "color": "#cccccc",
                          "opacity": 1
                        },
                        "description": "网格线颜色"
                      },
                      "type": {
                        "type": "string",
                        "enum": [
                          "solid",
                          "dashed",
                          "dotted"
                        ],
                        "default": "solid",
                        "description": "网格线类型"
                      }
                    },
                    "required": [
                      "show",
                      "width",
                      "color",
                      "type"
                    ]
                  },
                  "position": {
                    "type": "string",
                    "enum": [
                      "top",
                      "bottom"
                    ],
                    "default": "bottom",
                    "description": "X轴位置"
                  },
                  "type": {
                    "type": "string",
                    "enum": [
                      "value",
                      "category",
                      "time",
                      "log"
                    ],
                    "default": "category",
                    "description": "X轴类型"
                  }
                },
                "required": [
                  "line",
                  "label",
                  "grid",
                  "position",
                  "type"
                ]
              },
              "minItems": 1,
              "maxItems": 1
            },
            "yAxis": {
              "type": "array",
              "description": "Y轴配置数组，通常为2个 (左轴和右轴)",
              "items": {
                "type": "object",
                "description": "Y轴配置单元",
                "properties": {
                  "line": {
                    "type": "object",
                    "description": "坐标轴线配置",
                    "properties": {
                      "show": {
                        "type": "boolean",
                        "default": true
                      },
                      "width": {
                        "type": "number",
                        "default": 1
                      },
                      "color": {
                        "$ref": "commonChartDefinitions.json#/definitions/simpleColor",
                        "default": {
                          "color": "#000000",
                          "opacity": 1
                        }
                      }
                    },
                    "required": [
                      "show",
                      "width",
                      "color"
                    ]
                  },
                  "label": {
                    "type": "object",
                    "description": "坐标轴标签配置",
                    "properties": {
                      "show": {
                        "type": "boolean",
                        "default": true
                      },
                      "fontFamily": {
                        "type": "string",
                        "default": "Misans 常规"
                      },
                      "fontSize": {
                        "type": "number",
                        "default": 12
                      },
                      "color": {
                        "$ref": "commonChartDefinitions.json#/definitions/simpleColor",
                        "default": {
                          "color": "#000000",
                          "opacity": 1
                        }
                      },
                      "angle": {
                        "type": "number",
                        "default": 0
                      },
                      "suffix": {
                        "type": "string",
                        "default": ""
                      }
                    },
                    "required": [
                      "show",
                      "fontFamily",
                      "fontSize",
                      "color",
                      "angle",
                      "suffix"
                    ]
                  },
                  "grid": {
                    "type": "object",
                    "description": "坐标轴网格线配置",
                    "properties": {
                      "show": {
                        "type": "boolean",
                        "default": true
                      },
                      "width": {
                        "type": "number",
                        "default": 1
                      },
                      "color": {
                        "$ref": "commonChartDefinitions.json#/definitions/simpleColor",
                        "default": {
                          "color": "#cccccc",
                          "opacity": 1
                        }
                      },
                      "type": {
                        "type": "string",
                        "enum": [
                          "solid",
                          "dashed",
                          "dotted"
                        ],
                        "default": "solid"
                      }
                    },
                    "required": [
                      "show",
                      "width",
                      "color",
                      "type"
                    ]
                  },
                  "position": {
                    "type": "string",
                    "enum": [
                      "left",
                      "right"
                    ],
                    "description": "Y轴位置 (e.g., 'left' for first, 'right' for second)"
                  },
                  "type": {
                    "type": "string",
                    "enum": [
                      "value",
                      "category",
                      "time",
                      "log"
                    ],
                    "default": "value",
                    "description": "Y轴类型"
                  },
                  "stepOfLabel": {
                    "oneOf": [
                      {
                        "type": "number"
                      },
                      {
                        "type": "string",
                        "enum": [
                          "auto"
                        ]
                      }
                    ],
                    "default": "auto",
                    "description": "标签步长"
                  },
                  "range": {
                    "type": "array",
                    "items": {
                      "type": "number"
                    },
                    "default": [],
                    "description": "坐标轴范围 [min, max]"
                  }
                },
                "required": [
                  "line",
                  "label",
                  "grid",
                  "position",
                  "type",
                  "stepOfLabel"
                ]
              },
              "minItems": 2,
              "maxItems": 2
            }
          },
          "required": [
            "show",
            "xAxis",
            "yAxis"
          ]
        },
        "numberFormat": {
          "$ref": "commonChartDefinitions.json#/definitions/numberFormatConfig"
        },
        "animation": {
          "$ref": "commonChartDefinitions.json#/definitions/animationConfig"
        },
        "tooltip": {
          "$ref": "commonChartDefinitions.json#/definitions/tooltipConfig"
        },
        "padding": {
          "$ref": "commonChartDefinitions.json#/definitions/paddingConfig"
        }
      },
      "required": [
        "type",
        "title",
        "background",
        "map",
        "fill",
        "display",
        "legend",
        "label",
        "axis",
        "numberFormat",
        "animation",
        "tooltip",
        "padding"
      ]
    }
  },
  "required": [
    "data",
    "pipe",
    "props"
  ]
}