{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.com/schemas/basicRadarChartSchema.json",
  "title": "Basic Radar Chart Configuration",
  "description": "Schema for configuring a basic radar chart, with fully inlined axis configurations.",
  "type": "object",
  "properties": {
    "data": {
      "$ref": "commonChartDefinitions.json#/definitions/chartDataArray"
    },
    "pipe": {
      "type": "string",
      "default": "cross",
      "description": "数据处理方式，用于图表绘制时的数据转换或处理流程，例如 \"cross\""
    },
    "props": {
      "type": "object",
      "description": "图表的配置项",
      "properties": {
        "type": {
          "type": "string",
          "const": "basic-radar",
          "description": "图表类型固定为雷达图"
        },
        "title": {
          "$ref": "commonChartDefinitions.json#/definitions/titleConfig"
        },
        "background": {
          "$ref": "commonChartDefinitions.json#/definitions/backgroundConfig"
        },
        "map": {
          "type": "array",
          "description": "数据映射配置 (angle-axis categories, and then multiple series with values)",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "description": "映射名称, e.g., '周向轴对象' for categories, or series name for values"
              },
              "index": {
                "type": "number",
                "description": "数据列索引"
              },
              "isLegend": {
                "type": "boolean",
                "description": "第一列是否作为图例，其他列默认为false"
              },
              "function": {
                "type": "string",
                "description": "映射函数类型 (e.g., 'objCol' for angle categories, 'vCol' for series values)"
              },
              "configurable": {
                "type": "boolean",
                "description": "图表是否绘制这一列数值"
              },
              "angleIndex": {
                "type": "number",
                "description": "对应的周向轴（角度轴）索引 (usually 0)"
              },
              "radiusIndex": {
                "type": "number",
                "description": "对应的径向轴（半径轴）索引 (usually 0)"
              },
              "type": {
                "type": "string",
                "description": "图表中绘制的元素类型 ('area' for radar series)",
                "enum": [
                  "area"
                ]
              }
            },
            "required": [
              "name",
              "index",
              "isLegend",
              "function",
              "configurable",
              "type"
            ],
            "oneOf": [
              {
                "description": "Must have angleIndex and not radiusIndex.",
                "required": [
                  "angleIndex"
                ],
                "properties": {
                  "radiusIndex": false
                }
              },
              {
                "description": "Must have radiusIndex and not angleIndex.",
                "required": [
                  "radiusIndex"
                ],
                "properties": {
                  "angleIndex": false
                }
              }
            ]
          }
        },
        "fill": {
          "type": "object",
          "description": "系列（雷达区域）颜色配置",
          "properties": {
            "controlType": {
              "type": "string",
              "enum": [
                "single",
                "multiple",
                "gradient"
              ],
              "default": "multiple"
            },
            "props": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "color": {
                    "$ref": "commonChartDefinitions.json#/definitions/colorOption"
                  },
                  "shadow": {
                    "type": "object",
                    "properties": {
                      "show": {
                        "type": "boolean",
                        "default": false
                      },
                      "type": {
                        "type": "string",
                        "enum": [
                          "outer",
                          "inner"
                        ],
                        "default": "outer"
                      },
                      "angle": {
                        "type": "number",
                        "default": 45
                      },
                      "blur": {
                        "type": "number",
                        "default": 3
                      },
                      "color": {
                        "$ref": "commonChartDefinitions.json#/definitions/simpleColor",
                        "default": {
                          "color": "#000000",
                          "opacity": 0.1
                        }
                      },
                      "radius": {
                        "type": "number",
                        "default": 2
                      }
                    }
                  }
                },
                "required": [
                  "color",
                  "shadow"
                ]
              }
            }
          },
          "required": [
            "controlType",
            "props"
          ]
        },
        "display": {
          "type": "object",
          "description": "显示配置，定义雷达图区域的显示属性",
          "properties": {
            "area": {
              "type": "object",
              "description": "雷达图区域特定显示属性",
              "properties": {
                "type": {
                  "type": "string",
                  "enum": [
                    "straight",
                    "curve"
                  ],
                  "default": "straight",
                  "description": "区域边界线条类型，折线或曲线"
                },
                "width": {
                  "type": "number",
                  "default": 2,
                  "minimum": 0,
                  "description": "区域边界线条宽度"
                },
                "fillOpacity": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1,
                  "default": 0.5,
                  "description": "雷达图区域整体填充透明度 (0-1)"
                },
                "endPoint": {
                  "type": "object",
                  "description": "区域边界线条节点（标记点）配置",
                  "properties": {
                    "radius": {
                      "type": "number",
                      "default": 3,
                      "minimum": 0,
                      "description": "节点半径, 0 to hide"
                    },
                    "width": {
                      "type": "number",
                      "default": 1,
                      "minimum": 0,
                      "description": "节点描边宽度"
                    },
                    "color": {
                      "$ref": "commonChartDefinitions.json#/definitions/borderElementColorOption",
                      "description": "节点描边颜色 (null for auto/line color)"
                    },
                    "fill": {
                      "$ref": "commonChartDefinitions.json#/definitions/borderElementColorOption",
                      "description": "节点填充颜色 (null for auto/line color)"
                    }
                  },
                  "required": [
                    "radius",
                    "width",
                    "color",
                    "fill"
                  ]
                }
              },
              "required": [
                "type",
                "width",
                "fillOpacity",
                "endPoint"
              ]
            }
          },
          "required": [
            "area"
          ]
        },
        "legend": {
          "$ref": "commonChartDefinitions.json#/definitions/legendConfig"
        },
        "label": {
          "type": "object",
          "description": "标签配置",
          "properties": {
            "show": {
              "type": "boolean",
              "default": false,
              "description": "是否显示所有标签（总开关）"
            },
            "areaLabel": {
              "type": "object",
              "description": "雷达图数据点标签配置",
              "properties": {
                "show": {
                  "type": "boolean",
                  "default": false,
                  "description": "是否显示雷达图数据点标签"
                },
                "fontFamily": {
                  "type": "string",
                  "default": "Misans 常规"
                },
                "fontSize": {
                  "type": "number",
                  "default": 12
                },
                "color": {
                  "$ref": "commonChartDefinitions.json#/definitions/simpleColor",
                  "default": {
                    "color": "#000000",
                    "opacity": 1
                  }
                },
                "suffix": {
                  "type": "string",
                  "default": ""
                }
              },
              "required": [
                "show",
                "fontFamily",
                "fontSize",
                "color",
                "suffix"
              ]
            },
            "highlight": {
              "type": "boolean",
              "default": false
            },
            "overlap": {
              "type": "boolean",
              "default": false
            }
          },
          "required": [
            "show",
            "areaLabel",
            "highlight",
            "overlap"
          ]
        },
        "axis": {
          "type": "object",
          "description": "坐标轴配置 (周向轴和径向轴)",
          "properties": {
            "show": {
              "type": "boolean",
              "default": true,
              "description": "是否显示坐标轴"
            },
            "angleAxis": {
              "type": "array",
              "description": "周向轴（角度轴）配置数组",
              "items": {
                "type": "object",
                "description": "周向轴配置单元",
                "properties": {
                  "line": {
                    "type": "object",
                    "description": "轴线（雷达 spokes）配置",
                    "properties": {
                      "show": {
                        "type": "boolean",
                        "default": true
                      },
                      "width": {
                        "type": "number",
                        "default": 1
                      },
                      "color": {
                        "$ref": "commonChartDefinitions.json#/definitions/simpleColor",
                        "default": {
                          "color": "#cccccc",
                          "opacity": 1
                        }
                      }
                    },
                    "required": [
                      "show",
                      "width",
                      "color"
                    ]
                  },
                  "label": {
                    "type": "object",
                    "description": "轴标签（维度名称）配置",
                    "properties": {
                      "show": {
                        "type": "boolean",
                        "default": true
                      },
                      "direction": {
                        "type": "string",
                        "enum": [
                          "horizontal",
                          "circumference",
                          "radial"
                        ],
                        "default": "horizontal",
                        "description": "标签方向 (horizontal often best for radar labels)"
                      },
                      "fontFamily": {
                        "type": "string",
                        "default": "Misans 常规"
                      },
                      "fontSize": {
                        "type": "number",
                        "default": 12
                      },
                      "color": {
                        "$ref": "commonChartDefinitions.json#/definitions/simpleColor",
                        "default": {
                          "color": "#000000",
                          "opacity": 1
                        }
                      }
                    },
                    "required": [
                      "show",
                      "direction",
                      "fontFamily",
                      "fontSize",
                      "color"
                    ]
                  },
                  "grid": {
                    "type": "object",
                    "description": "轴网格线（多边形网格）配置",
                    "properties": {
                      "show": {
                        "type": "boolean",
                        "default": true
                      },
                      "width": {
                        "type": "number",
                        "default": 1
                      },
                      "color": {
                        "$ref": "commonChartDefinitions.json#/definitions/simpleColor",
                        "default": {
                          "color": "#cccccc",
                          "opacity": 1
                        }
                      },
                      "type": {
                        "type": "string",
                        "enum": [
                          "solid",
                          "dashed",
                          "dotted"
                        ],
                        "default": "solid"
                      }
                    },
                    "required": [
                      "show",
                      "width",
                      "color",
                      "type"
                    ]
                  },
                  "position": {
                    "type": "string",
                    "enum": [
                      "inside",
                      "outside"
                    ],
                    "default": "outside",
                    "description": "轴标签位置"
                  },
                  "type": {
                    "type": "string",
                    "enum": [
                      "category"
                    ],
                    "default": "category",
                    "description": "周向轴类型 (必须为 category for radar)"
                  }
                },
                "required": [
                  "line",
                  "label",
                  "grid",
                  "position",
                  "type"
                ]
              },
              "minItems": 1,
              "maxItems": 1
            },
            "radiusAxis": {
              "type": "array",
              "description": "径向轴（半径轴）配置数组",
              "items": {
                "type": "object",
                "description": "径向轴配置单元",
                "properties": {
                  "line": {
                    "type": "object",
                    "description": "轴线配置",
                    "properties": {
                      "show": {
                        "type": "boolean",
                        "default": false
                      },
                      "width": {
                        "type": "number",
                        "default": 1
                      },
                      "color": {
                        "$ref": "commonChartDefinitions.json#/definitions/simpleColor",
                        "default": {
                          "color": "#000000",
                          "opacity": 1
                        }
                      }
                    },
                    "required": [
                      "show",
                      "width",
                      "color"
                    ]
                  },
                  "label": {
                    "type": "object",
                    "description": "轴标签（刻度值）配置",
                    "properties": {
                      "show": {
                        "type": "boolean",
                        "default": true
                      },
                      "fontFamily": {
                        "type": "string",
                        "default": "Misans 常规"
                      },
                      "fontSize": {
                        "type": "number",
                        "default": 10
                      },
                      "color": {
                        "$ref": "commonChartDefinitions.json#/definitions/simpleColor",
                        "default": {
                          "color": "#666666",
                          "opacity": 1
                        }
                      },
                      "suffix": {
                        "type": "string",
                        "default": ""
                      }
                    },
                    "required": [
                      "show",
                      "fontFamily",
                      "fontSize",
                      "color",
                      "suffix"
                    ]
                  },
                  "grid": {
                    "type": "object",
                    "description": "轴网格线配置 (通常不显示或由周向轴网格定义)",
                    "properties": {
                      "show": {
                        "type": "boolean",
                        "default": false
                      },
                      "width": {
                        "type": "number",
                        "default": 1
                      },
                      "color": {
                        "$ref": "commonChartDefinitions.json#/definitions/simpleColor",
                        "default": {
                          "color": "#cccccc",
                          "opacity": 1
                        }
                      },
                      "type": {
                        "type": "string",
                        "enum": [
                          "solid",
                          "dashed",
                          "dotted"
                        ],
                        "default": "solid"
                      },
                      "background": {
                        "type": "object",
                        "description": "雷达图网格线之间的背景区域样式",
                        "properties": {
                          "color": {
                            "type": "array",
                            "description": "相邻两根网格线之间区域的交替颜色，数组长度2",
                            "items": {
                              "$ref": "commonChartDefinitions.json#/definitions/simpleColor"
                            },
                            "minItems": 2,
                            "maxItems": 2
                          },
                          "style": {
                            "type": "string",
                            "description": "雷达图网格线背景形状，圆形或者多边形",
                            "enum": [
                              "circle",
                              "polygon"
                            ],
                            "default": "polygon"
                          }
                        },
                        "required": [
                          "color",
                          "style"
                        ]
                      }
                    },
                    "required": [
                      "show",
                      "width",
                      "color",
                      "type",
                      "background"
                    ]
                  },
                  "position": {
                    "type": "string",
                    "enum": [
                      "inside",
                      "outside"
                    ],
                    "default": "inside",
                    "description": "轴刻度标签位置"
                  },
                  "type": {
                    "type": "string",
                    "enum": [
                      "value"
                    ],
                    "default": "value",
                    "description": "径向轴类型 (必须为 value for radar)"
                  },
                  "stepOfLabel": {
                    "oneOf": [
                      {
                        "type": "number"
                      },
                      {
                        "type": "string",
                        "enum": [
                          "auto"
                        ]
                      }
                    ],
                    "default": "auto"
                  },
                  "range": {
                    "type": "array",
                    "items": {
                      "type": "number"
                    },
                    "default": [],
                    "description": "坐标轴范围 [min, max]"
                  }
                },
                "required": [
                  "line",
                  "label",
                  "grid",
                  "position",
                  "type",
                  "stepOfLabel"
                ]
              },
              "minItems": 1,
              "maxItems": 1
            }
          },
          "required": [
            "show",
            "angleAxis",
            "radiusAxis"
          ]
        },
        "numberFormat": {
          "$ref": "commonChartDefinitions.json#/definitions/numberFormatConfig"
        },
        "animation": {
          "$ref": "commonChartDefinitions.json#/definitions/animationConfig"
        },
        "tooltip": {
          "$ref": "commonChartDefinitions.json#/definitions/tooltipConfig"
        },
        "padding": {
          "$ref": "commonChartDefinitions.json#/definitions/paddingConfig"
        }
      },
      "required": [
        "type",
        "title",
        "background",
        "map",
        "fill",
        "display",
        "legend",
        "label",
        "axis",
        "numberFormat",
        "animation",
        "tooltip",
        "padding"
      ]
    }
  },
  "required": [
    "data",
    "pipe",
    "props"
  ]
}