{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.com/schemas/sankeyDiagramSchema.json",
  "title": "Sankey Diagram Configuration",
  "description": "Schema for configuring a Sankey diagram.",
  "type": "object",
  "properties": {
    "data": {
      "$ref": "commonChartDefinitions.json#/definitions/chartDataArray"
    },
    "pipe": {
      "type": "string",
      "default": "key_value",
      "description": "数据处理方式，例如 \"key_value\""
    },
    "props": {
      "type": "object",
      "description": "图表的配置项",
      "properties": {
        "type": {
          "type": "string",
          "const": "sankey",
          "description": "图表类型固定为桑基图"
        },
        "title": {
          "$ref": "commonChartDefinitions.json#/definitions/titleConfig"
        },
        "background": {
          "$ref": "commonChartDefinitions.json#/definitions/backgroundConfig"
        },
        "map": {
          "type": "array",
          "description": "数据映射配置 (Source, Target, Value)",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "description": "映射名称, e.g., '起始项', '目标项', '数值'"
              },
              "index": {
                "type": "number",
                "description": "数据列索引"
              },
              "isLegend": {
                "type": "boolean",
                "default": false,
                "description": "此列是否作为图例 (nodes usually are)"
              },
              "function": {
                "type": "string",
                "description": "映射函数类型",
                "enum": [
                  "sourceCol",
                  "targetCol",
                  "vCol",
                  "objCol"
                ]
              },
              "configurable": {
                "type": "boolean",
                "description": "图表是否绘制这一列数值"
              },
              "type": {
                "type": "string",
                "description": "图表中绘制的元素类型",
                "enum": [
                  "sankey"
                ]
              }
            },
            "required": [
              "name",
              "index",
              "isLegend",
              "function",
              "configurable",
              "type"
            ]
          },
          "minItems": 3,
          "maxItems": 3
        },
        "fill": {
          "type": "object",
          "description": "桑基图节点颜色配置",
          "properties": {
            "controlType": {
              "type": "string",
              "enum": [
                "single",
                "multiple",
                "gradient"
              ],
              "default": "multiple"
            },
            "props": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "color": {
                    "$ref": "commonChartDefinitions.json#/definitions/colorOption"
                  },
                  "shadow": {
                    "type": "object",
                    "properties": {
                      "show": {
                        "type": "boolean",
                        "default": false
                      },
                      "type": {
                        "type": "string",
                        "enum": [
                          "outer",
                          "inner"
                        ],
                        "default": "outer"
                      },
                      "angle": {
                        "type": "number",
                        "default": 45
                      },
                      "blur": {
                        "type": "number",
                        "default": 3
                      },
                      "color": {
                        "$ref": "commonChartDefinitions.json#/definitions/simpleColor",
                        "default": {
                          "color": "#000000",
                          "opacity": 0.2
                        }
                      },
                      "radius": {
                        "type": "number",
                        "default": 2
                      }
                    }
                  }
                },
                "required": [
                  "color",
                  "shadow"
                ]
              }
            }
          },
          "required": [
            "controlType",
            "props"
          ]
        },
        "display": {
          "type": "object",
          "description": "显示配置，定义桑基图节点和连接线的显示属性",
          "properties": {
            "sankey": {
              "type": "object",
              "description": "桑基图特定显示属性",
              "properties": {
                "gapDistance": {
                  "type": "number",
                  "default": 8,
                  "minimum": 0,
                  "description": "桑基图矩形节点上下之间的间隙"
                },
                "fillOpacity": {
                  "type": "number",
                  "default": 0.3,
                  "minimum": 0,
                  "maximum": 1,
                  "description": "桑基图矩形节点之间连接线（流）整体透明度"
                },
                "nodeWidth": {
                  "type": "number",
                  "default": 10,
                  "minimum": 1,
                  "description": "桑基图矩形节点宽度"
                },
                "color": {
                  "description": "桑基图矩形节点之间连接线颜色",
                  "oneOf": [
                    {
                      "$ref": "commonChartDefinitions.json#/definitions/simpleColor"
                    },
                    {
                      "type": "string",
                      "const": "gradient",
                      "description": "连线颜色为线两端矩形节点颜色的渐变"
                    },
                    {
                      "type": "null",
                      "description": "自动色，与连线起始矩形节点填充色相同"
                    }
                  ],
                  "default": null
                }
              },
              "required": [
                "gapDistance",
                "fillOpacity",
                "nodeWidth",
                "color"
              ]
            }
          },
          "required": [
            "sankey"
          ]
        },
        "legend": {
          "$ref": "commonChartDefinitions.json#/definitions/legendConfig"
        },
        "label": {
          "type": "object",
          "description": "标签配置 (用于桑基图节点)",
          "properties": {
            "show": {
              "type": "boolean",
              "default": true,
              "description": "是否显示所有标签（总开关）"
            },
            "textLabel": {
              "type": "object",
              "description": "节点文字标签 (节点名称)",
              "properties": {
                "show": {
                  "type": "boolean",
                  "default": true
                },
                "positionChoice": {
                  "type": "string",
                  "enum": [
                    "inside",
                    "outside",
                    "horizontal-center",
                    "vertical-center"
                  ],
                  "default": "inside"
                },
                "fontFamily": {
                  "type": "string",
                  "default": "Misans 常规"
                },
                "fontSize": {
                  "type": "number",
                  "default": 12
                },
                "color": {
                  "$ref": "commonChartDefinitions.json#/definitions/simpleColor",
                  "default": {
                    "color": "#000000",
                    "opacity": 1
                  }
                }
              },
              "required": [
                "show",
                "positionChoice",
                "fontFamily",
                "fontSize",
                "color"
              ]
            },
            "numberLabel": {
              "type": "object",
              "description": "节点数值标签 (节点流量值)",
              "properties": {
                "show": {
                  "type": "boolean",
                  "default": false
                },
                "positionChoice": {
                  "type": "string",
                  "enum": [
                    "inside",
                    "outside",
                    "horizontal-center",
                    "vertical-center"
                  ],
                  "default": "inside"
                },
                "fontFamily": {
                  "type": "string",
                  "default": "Misans 常规"
                },
                "fontSize": {
                  "type": "number",
                  "default": 10
                },
                "color": {
                  "$ref": "commonChartDefinitions.json#/definitions/simpleColor",
                  "default": {
                    "color": "#000000",
                    "opacity": 1
                  }
                },
                "suffix": {
                  "type": "string",
                  "default": ""
                }
              },
              "required": [
                "show",
                "positionChoice",
                "fontFamily",
                "fontSize",
                "color",
                "suffix"
              ]
            },
            "highlight": {
              "type": "boolean",
              "default": false
            },
            "overlap": {
              "type": "boolean",
              "default": false,
              "description": "是否允许标签重叠 (Sankey labels are often outside or managed to avoid overlap)"
            }
          },
          "required": [
            "show",
            "textLabel",
            "numberLabel",
            "highlight",
            "overlap"
          ]
        },
        "numberFormat": {
          "$ref": "commonChartDefinitions.json#/definitions/numberFormatConfig"
        },
        "animation": {
          "$ref": "commonChartDefinitions.json#/definitions/animationConfig"
        },
        "tooltip": {
          "$ref": "commonChartDefinitions.json#/definitions/tooltipConfig"
        },
        "padding": {
          "$ref": "commonChartDefinitions.json#/definitions/paddingConfig"
        }
      },
      "required": [
        "type",
        "title",
        "background",
        "map",
        "fill",
        "display",
        "legend",
        "label",
        "numberFormat",
        "animation",
        "tooltip",
        "padding"
      ]
    }
  },
  "required": [
    "data",
    "pipe",
    "props"
  ]
}