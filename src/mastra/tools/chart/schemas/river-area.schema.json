{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.com/schemas/riverAreaChartSchema.json",
  "title": "River Area Chart Configuration",
  "description": "Schema for configuring a river area chart (streamgraph), referencing common definitions.",
  "type": "object",
  "properties": {
    "data": {
      "$ref": "commonChartDefinitions.json#/definitions/chartDataArray"
    },
    "pipe": {
      "type": "string",
      "default": "cross",
      "description": "数据处理方式，用于图表绘制时的数据转换或处理流程，例如 \"cross\""
    },
    "props": {
      "type": "object",
      "description": "图表的配置项",
      "properties": {
        "type": {
          "type": "string",
          "const": "river-area",
          "description": "图表类型固定为河流图"
        },
        "title": {
          "$ref": "commonChartDefinitions.json#/definitions/titleConfig"
        },
        "background": {
          "$ref": "commonChartDefinitions.json#/definitions/backgroundConfig"
        },
        "map": {
          "type": "array",
          "description": "数据映射配置，定义数据列如何映射到图表的各个部分",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "description": "映射名称，例如 \"X轴对象\"或者\"数值列\""
              },
              "index": {
                "type": "number",
                "description": "数据列索引"
              },
              "isLegend": {
                "type": "boolean",
                "description": "第一列是否作为图例，其他列默认为false"
              },
              "function": {
                "type": "string",
                "description": "映射函数类型，例如 \"objCol\" 表示对象列，\"vCol\"表示数值列"
              },
              "configurable": {
                "type": "boolean",
                "description": "图表是否绘制这一列数值"
              },
              "xAxisIndex": {
                "type": "number",
                "description": "对应的X轴索引"
              },
              "yAxisIndex": {
                "type": "number",
                "description": "对应的Y轴索引"
              },
              "type": {
                "type": "string",
                "description": "图表中绘制的元素类型",
                "enum": [
                  "area"
                ]
              }
            },
            "required": [
              "name",
              "index",
              "isLegend",
              "function",
              "configurable",
              "type"
            ],
            "oneOf": [
              {
                "description": "Must have xAxisIndex and not yAxisIndex.",
                "required": [
                  "xAxisIndex"
                ],
                "properties": {
                  "yAxisIndex": false
                }
              },
              {
                "description": "Must have yAxisIndex and not xAxisIndex.",
                "required": [
                  "yAxisIndex"
                ],
                "properties": {
                  "xAxisIndex": false
                }
              }
            ]
          }
        },
        "fill": {
          "type": "object",
          "description": "系列（河流层）颜色配置",
          "properties": {
            "controlType": {
              "type": "string",
              "enum": [
                "single",
                "multiple",
                "gradient"
              ],
              "description": "颜色控制类型"
            },
            "props": {
              "type": "array",
              "description": "颜色属性数组，每个对象定义一种河流层的颜色或样式",
              "items": {
                "type": "object",
                "properties": {
                  "color": {
                    "$ref": "commonChartDefinitions.json#/definitions/colorOption"
                  },
                  "shadow": {
                    "type": "object",
                    "description": "河流层阴影配置（可选）",
                    "properties": {
                      "show": {
                        "type": "boolean",
                        "default": false
                      },
                      "type": {
                        "type": "string",
                        "enum": [
                          "outer",
                          "inner"
                        ],
                        "default": "outer"
                      },
                      "angle": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 360,
                        "default": 45
                      },
                      "blur": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 100,
                        "default": 5
                      },
                      "color": {
                        "$ref": "commonChartDefinitions.json#/definitions/simpleColor",
                        "default": {
                          "color": "#000000",
                          "opacity": 0.1
                        }
                      },
                      "radius": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 100,
                        "default": 3
                      }
                    }
                  }
                },
                "required": [
                  "color",
                  "shadow"
                ]
              }
            }
          },
          "required": [
            "controlType",
            "props"
          ]
        },
        "display": {
          "type": "object",
          "description": "显示配置，定义图表元素的显示属性",
          "properties": {
            "area": {
              "type": "object",
              "description": "河流图特定显示属性",
              "properties": {
                "type": {
                  "type": "string",
                  "enum": [
                    "straight",
                    "curve"
                  ],
                  "default": "curve",
                  "description": "层边界线条类型，折线或曲线"
                },
                "width": {
                  "type": "number",
                  "default": 1,
                  "minimum": 0,
                  "description": "层边界线条宽度 (0 to hide lines between layers)"
                },
                "fillOpacity": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1,
                  "default": 0.85,
                  "description": "河流图层整体填充透明度 (0-1)"
                }
              },
              "required": [
                "type",
                "width",
                "fillOpacity"
              ]
            }
          },
          "required": [
            "area"
          ]
        },
        "legend": {
          "$ref": "commonChartDefinitions.json#/definitions/legendConfig"
        },
        "label": {
          "type": "object",
          "description": "标签配置",
          "properties": {
            "show": {
              "type": "boolean",
              "default": false,
              "description": "是否显示所有标签（总开关）"
            },
            "areaLabel": {
              "type": "object",
              "description": "河流图层标签配置",
              "properties": {
                "show": {
                  "type": "boolean",
                  "default": false,
                  "description": "是否显示河流图层标签"
                },
                "fontFamily": {
                  "type": "string",
                  "default": "Misans 常规"
                },
                "fontSize": {
                  "type": "number",
                  "default": 10
                },
                "color": {
                  "$ref": "commonChartDefinitions.json#/definitions/simpleColor",
                  "default": {
                    "color": "#000000",
                    "opacity": 1
                  }
                },
                "suffix": {
                  "type": "string",
                  "default": ""
                }
              },
              "required": [
                "show",
                "fontFamily",
                "fontSize",
                "color",
                "suffix"
              ]
            },
            "highlight": {
              "type": "boolean",
              "default": false
            },
            "overlap": {
              "type": "boolean",
              "default": false
            }
          },
          "required": [
            "show",
            "areaLabel",
            "highlight",
            "overlap"
          ]
        },
        "axis": {
          "type": "object",
          "description": "坐标轴配置",
          "properties": {
            "show": {
              "type": "boolean",
              "default": true,
              "description": "总开关，控制所有坐标轴的显隐，但通常X轴会显示"
            },
            "xAxis": {
              "type": "array",
              "description": "X轴配置数组",
              "items": {
                "type": "object",
                "properties": {
                  "line": {
                    "type": "object",
                    "properties": {
                      "show": {
                        "type": "boolean",
                        "default": true
                      },
                      "width": {
                        "type": "number",
                        "default": 1
                      },
                      "color": {
                        "$ref": "commonChartDefinitions.json#/definitions/simpleColor",
                        "default": {
                          "color": "#000000",
                          "opacity": 1
                        }
                      }
                    },
                    "required": [
                      "show",
                      "width",
                      "color"
                    ]
                  },
                  "label": {
                    "type": "object",
                    "properties": {
                      "show": {
                        "type": "boolean",
                        "default": true
                      },
                      "direction": {
                        "type": "string",
                        "enum": [
                          "horizontal",
                          "auto"
                        ],
                        "default": "auto"
                      },
                      "fontFamily": {
                        "type": "string",
                        "default": "Misans 常规"
                      },
                      "fontSize": {
                        "type": "number",
                        "default": 12
                      },
                      "color": {
                        "$ref": "commonChartDefinitions.json#/definitions/simpleColor",
                        "default": {
                          "color": "#000000",
                          "opacity": 1
                        }
                      },
                      "angle": {
                        "type": "number",
                        "default": 0
                      }
                    },
                    "required": [
                      "show",
                      "direction",
                      "fontFamily",
                      "fontSize",
                      "color",
                      "angle"
                    ]
                  },
                  "grid": {
                    "type": "object",
                    "properties": {
                      "show": {
                        "type": "boolean",
                        "default": true
                      },
                      "width": {
                        "type": "number",
                        "default": 1
                      },
                      "color": {
                        "$ref": "commonChartDefinitions.json#/definitions/simpleColor",
                        "default": {
                          "color": "#cccccc",
                          "opacity": 0.3
                        }
                      },
                      "type": {
                        "type": "string",
                        "enum": [
                          "solid",
                          "dashed",
                          "dotted"
                        ],
                        "default": "dashed"
                      }
                    },
                    "required": [
                      "show",
                      "width",
                      "color",
                      "type"
                    ]
                  },
                  "position": {
                    "type": "string",
                    "enum": [
                      "top",
                      "bottom"
                    ],
                    "default": "bottom"
                  },
                  "type": {
                    "type": "string",
                    "enum": [
                      "value",
                      "category",
                      "time",
                      "log"
                    ],
                    "default": "category"
                  }
                },
                "required": [
                  "line",
                  "label",
                  "grid",
                  "position",
                  "type"
                ]
              },
              "minItems": 1
            }
          },
          "required": [
            "show",
            "xAxis"
          ]
        },
        "numberFormat": {
          "$ref": "commonChartDefinitions.json#/definitions/numberFormatConfig"
        },
        "animation": {
          "$ref": "commonChartDefinitions.json#/definitions/animationConfig"
        },
        "tooltip": {
          "$ref": "commonChartDefinitions.json#/definitions/tooltipConfig"
        },
        "padding": {
          "$ref": "commonChartDefinitions.json#/definitions/paddingConfig"
        }
      },
      "required": [
        "type",
        "title",
        "background",
        "map",
        "fill",
        "display",
        "legend",
        "label",
        "axis",
        "numberFormat",
        "animation",
        "tooltip",
        "padding"
      ]
    }
  },
  "required": [
    "data",
    "pipe",
    "props"
  ]
}