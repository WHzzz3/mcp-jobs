{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.com/schemas/voronoiDiagramSchema.json",
  "title": "Voronoi Diagram Configuration",
  "description": "Schema for configuring a Voronoi diagram.",
  "type": "object",
  "properties": {
    "data": {
      "$ref": "commonChartDefinitions.json#/definitions/chartDataArray"
    },
    "pipe": {
      "type": "string",
      "default": "key_value",
      "description": "数据处理方式，例如 \"key_value\""
    },
    "props": {
      "type": "object",
      "description": "图表的配置项",
      "properties": {
        "type": {
          "type": "string",
          "const": "voronoi",
          "description": "图表类型固定为维诺图"
        },
        "title": {
          "$ref": "commonChartDefinitions.json#/definitions/titleConfig"
        },
        "background": {
          "$ref": "commonChartDefinitions.json#/definitions/backgroundConfig"
        },
        "map": {
          "type": "array",
          "description": "数据映射配置 (e.g., Level1-Cat, Level2-Cat/Object, Value)",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "description": "映射名称, e.g., '一级分类', '二级对象', '数值'"
              },
              "index": {
                "type": "number",
                "description": "数据列索引"
              },
              "isLegend": {
                "type": "boolean",
                "description": "此列是否作为图例 (e.g., Level1 categories for color)"
              },
              "function": {
                "type": "string",
                "description": "映射函数类型",
                "enum": [
                  "typeCol",
                  "objCol",
                  "vCol"
                ]
              },
              "configurable": {
                "type": "boolean",
                "description": "图表是否绘制这一列数值"
              },
              "type": {
                "type": "string",
                "description": "图表中绘制的元素类型 (Voronoi cell)",
                "enum": [
                  "voronoi"
                ]
              }
            },
            "required": [
              "name",
              "index",
              "isLegend",
              "function",
              "configurable",
              "type"
            ]
          },
          "minItems": 3,
          "maxItems": 3
        },
        "fill": {
          "type": "object",
          "description": "维诺图单元格颜色配置",
          "properties": {
            "controlType": {
              "type": "string",
              "enum": [
                "single",
                "multiple",
                "gradient"
              ],
              "default": "multiple"
            },
            "props": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "color": {
                    "$ref": "commonChartDefinitions.json#/definitions/colorOption"
                  },
                  "shadow": {
                    "type": "object",
                    "properties": {
                      "show": {
                        "type": "boolean",
                        "default": false
                      },
                      "type": {
                        "type": "string",
                        "enum": [
                          "outer",
                          "inner"
                        ],
                        "default": "outer"
                      },
                      "angle": {
                        "type": "number",
                        "default": 45
                      },
                      "blur": {
                        "type": "number",
                        "default": 2
                      },
                      "color": {
                        "$ref": "commonChartDefinitions.json#/definitions/simpleColor",
                        "default": {
                          "color": "#000000",
                          "opacity": 0.1
                        }
                      },
                      "radius": {
                        "type": "number",
                        "default": 1
                      }
                    }
                  }
                },
                "required": [
                  "color",
                  "shadow"
                ]
              }
            }
          },
          "required": [
            "controlType",
            "props"
          ]
        },
        "display": {
          "type": "object",
          "description": "显示配置，定义维诺图元素的显示属性",
          "properties": {
            "voronoi": {
              "type": "object",
              "description": "维诺图特定显示属性",
              "properties": {
                "drawShape": {
                  "type": "string",
                  "enum": [
                    "circle",
                    "triangle",
                    "rectangle",
                    "diamond",
                    "pentagon",
                    "hexagon",
                    "octagon"
                  ],
                  "default": "hexagon",
                  "description": "维诺图单元格的基础形状或整体边界形状"
                },
                "drawStyle": {
                  "type": "string",
                  "enum": [
                    "auto",
                    "fixed"
                  ],
                  "default": "auto",
                  "description": "绘制方式，自由比例或者固定比例 (for shapes)"
                },
                "cornerRadius": {
                  "type": "number",
                  "default": 0,
                  "minimum": 0,
                  "description": "多边形单元格圆角"
                },
                "fillOpacity": {
                  "type": "number",
                  "default": 0.85,
                  "minimum": 0,
                  "maximum": 1,
                  "description": "单元格整体填充不透明度"
                },
                "border": {
                  "type": "object",
                  "description": "一级（单元格）描边配置项",
                  "properties": {
                    "type": {
                      "type": "string",
                      "enum": [
                        "solid",
                        "dashed",
                        "dotted"
                      ],
                      "default": "solid"
                    },
                    "width": {
                      "type": "number",
                      "default": 1
                    },
                    "color": {
                      "$ref": "commonChartDefinitions.json#/definitions/borderElementColorOption",
                      "default": {
                        "color": "#FFFFFF",
                        "opacity": 0.7
                      }
                    }
                  },
                  "required": [
                    "type",
                    "width",
                    "color"
                  ]
                },
                "secondaryBorder": {
                  "type": "object",
                  "description": "二级（分组）描边配置项",
                  "properties": {
                    "type": {
                      "type": "string",
                      "enum": [
                        "solid",
                        "dashed",
                        "dotted"
                      ],
                      "default": "solid"
                    },
                    "width": {
                      "type": "number",
                      "default": 2
                    },
                    "color": {
                      "$ref": "commonChartDefinitions.json#/definitions/borderElementColorOption",
                      "default": {
                        "color": "#CCCCCC",
                        "opacity": 1
                      }
                    }
                  },
                  "required": [
                    "type",
                    "width",
                    "color"
                  ]
                }
              },
              "required": [
                "drawShape",
                "drawStyle",
                "cornerRadius",
                "fillOpacity",
                "border",
                "secondaryBorder"
              ]
            }
          },
          "required": [
            "voronoi"
          ]
        },
        "legend": {
          "$ref": "commonChartDefinitions.json#/definitions/legendConfig"
        },
        "label": {
          "type": "object",
          "description": "标签配置 (用于维诺图单元格)",
          "properties": {
            "show": {
              "type": "boolean",
              "default": true,
              "description": "是否显示所有标签（总开关）"
            },
            "textLabel": {
              "type": "object",
              "description": "文字标签 (e.g., '专业分类')",
              "properties": {
                "show": {
                  "type": "boolean",
                  "default": true
                },
                "fontFamily": {
                  "type": "string",
                  "default": "Misans 常规"
                },
                "fontSize": {
                  "type": "number",
                  "default": 10
                },
                "color": {
                  "$ref": "commonChartDefinitions.json#/definitions/simpleColor",
                  "default": {
                    "color": "#000000",
                    "opacity": 1
                  }
                }
              },
              "required": [
                "show",
                "fontFamily",
                "fontSize",
                "color"
              ]
            },
            "numberLabel": {
              "type": "object",
              "description": "数值标签 (e.g., '图书数量')",
              "properties": {
                "show": {
                  "type": "boolean",
                  "default": false
                },
                "fontFamily": {
                  "type": "string",
                  "default": "Misans 常规"
                },
                "fontSize": {
                  "type": "number",
                  "default": 9
                },
                "color": {
                  "$ref": "commonChartDefinitions.json#/definitions/simpleColor",
                  "default": {
                    "color": "#000000",
                    "opacity": 1
                  }
                },
                "suffix": {
                  "type": "string",
                  "default": ""
                }
              },
              "required": [
                "show",
                "fontFamily",
                "fontSize",
                "color",
                "suffix"
              ]
            },
            "highlight": {
              "type": "boolean",
              "default": true
            },
            "overlap": {
              "type": "boolean",
              "default": false,
              "description": "Allow labels to overlap or manage via truncation/hiding"
            }
          },
          "required": [
            "show",
            "textLabel",
            "numberLabel",
            "highlight",
            "overlap"
          ]
        },
        "numberFormat": {
          "$ref": "commonChartDefinitions.json#/definitions/numberFormatConfig"
        },
        "animation": {
          "$ref": "commonChartDefinitions.json#/definitions/animationConfig"
        },
        "tooltip": {
          "$ref": "commonChartDefinitions.json#/definitions/tooltipConfig"
        },
        "padding": {
          "$ref": "commonChartDefinitions.json#/definitions/paddingConfig"
        }
      },
      "required": [
        "type",
        "title",
        "background",
        "map",
        "fill",
        "display",
        "legend",
        "label",
        "numberFormat",
        "animation",
        "tooltip",
        "padding"
      ]
    }
  },
  "required": [
    "data",
    "pipe",
    "props"
  ]
}