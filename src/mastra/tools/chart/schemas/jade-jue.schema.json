{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.com/schemas/jadeJueChartSchema.json",
  "title": "Jade Jue Chart Configuration",
  "description": "Schema for configuring a Jade Jue chart, with fully inlined axis configurations.",
  "type": "object",
  "properties": {
    "data": {
      "$ref": "commonChartDefinitions.json#/definitions/chartDataArray"
    },
    "pipe": {
      "type": "string",
      "default": "key_value",
      "description": "数据处理方式，例如 \"key_value\""
    },
    "props": {
      "type": "object",
      "description": "图表的配置项",
      "properties": {
        "type": {
          "type": "string",
          "const": "jade-jue",
          "description": "图表类型固定为玉玦图"
        },
        "title": {
          "$ref": "commonChartDefinitions.json#/definitions/titleConfig"
        },
        "background": {
          "$ref": "commonChartDefinitions.json#/definitions/backgroundConfig"
        },
        "map": {
          "type": "array",
          "description": "数据映射配置 (e.g., category to radiusAxis, value to angleAxis)",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "description": "映射名称, e.g., '名称' or '值'"
              },
              "index": {
                "type": "number",
                "description": "数据列索引"
              },
              "isLegend": {
                "type": "boolean",
                "description": "第一列是否作为图例，其他列默认为false"
              },
              "function": {
                "type": "string",
                "description": "映射函数类型 (e.g., 'objCol' for category, 'vCol' for value)"
              },
              "configurable": {
                "type": "boolean",
                "description": "图表是否绘制这一列数值"
              },
              "angleIndex": {
                "type": "number",
                "description": "对应的周向轴（角度/值轴）索引"
              },
              "radiusIndex": {
                "type": "number",
                "description": "对应的径向轴（分类轴）索引"
              },
              "type": {
                "type": "string",
                "description": "图表中绘制的元素类型 (arc segment)",
                "enum": [
                  "pie"
                ]
              }
            },
            "required": [
              "name",
              "index",
              "isLegend",
              "function",
              "configurable",
              "type"
            ],
            "oneOf": [
              {
                "description": "Must have angleIndex and not radiusIndex.",
                "required": [
                  "angleIndex"
                ],
                "properties": {
                  "radiusIndex": false
                }
              },
              {
                "description": "Must have radiusIndex and not angleIndex.",
                "required": [
                  "radiusIndex"
                ],
                "properties": {
                  "angleIndex": false
                }
              }
            ]
          },
          "minItems": 2
        },
        "fill": {
          "type": "object",
          "description": "玉玦图扇段颜色配置",
          "properties": {
            "controlType": {
              "type": "string",
              "enum": [
                "single",
                "multiple",
                "gradient"
              ],
              "default": "multiple"
            },
            "props": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "color": {
                    "$ref": "commonChartDefinitions.json#/definitions/colorOption"
                  },
                  "shadow": {
                    "type": "object",
                    "properties": {
                      "show": {
                        "type": "boolean",
                        "default": false
                      },
                      "type": {
                        "type": "string",
                        "enum": [
                          "outer",
                          "inner"
                        ],
                        "default": "outer"
                      },
                      "angle": {
                        "type": "number",
                        "default": 45
                      },
                      "blur": {
                        "type": "number",
                        "default": 3
                      },
                      "color": {
                        "$ref": "commonChartDefinitions.json#/definitions/simpleColor",
                        "default": {
                          "color": "#000000",
                          "opacity": 0.2
                        }
                      },
                      "radius": {
                        "type": "number",
                        "default": 2
                      }
                    }
                  },
                  "border": {
                    "type": "object",
                    "properties": {
                      "type": {
                        "type": "string",
                        "enum": [
                          "solid",
                          "dashed",
                          "dotted"
                        ],
                        "default": "solid"
                      },
                      "width": {
                        "type": "number",
                        "default": 0
                      },
                      "color": {
                        "$ref": "commonChartDefinitions.json#/definitions/borderElementColorOption"
                      }
                    }
                  }
                },
                "required": [
                  "color",
                  "shadow",
                  "border"
                ]
              }
            }
          },
          "required": [
            "controlType",
            "props"
          ]
        },
        "display": {
          "type": "object",
          "description": "显示配置，定义玉玦图元素的显示属性",
          "properties": {
            "pie": {
              "type": "object",
              "description": "玉玦图特定显示属性",
              "properties": {
                "innerRadiusRatio": {
                  "type": "number",
                  "default": 0.6,
                  "minimum": 0,
                  "maximum": 0.99,
                  "description": "玉玦图整体内径占比 (creating the ring)"
                },
                "gapPercentage": {
                  "type": "number",
                  "default": 70,
                  "minimum": 0,
                  "maximum": 100,
                  "description": "单根玉玦宽度调整 (as a ratio of available space for this ring, effectively its thickness)"
                },
                "startAngle": {
                  "type": "number",
                  "enum": [
                    0,
                    90,
                    180,
                    270
                  ],
                  "default": 0,
                  "description": "玉玦绘制起始角度"
                },
                "drawAngle": {
                  "type": "number",
                  "default": 270,
                  "minimum": 1,
                  "maximum": 360,
                  "description": "玉玦绘制的总角度范围 (e.g., 270 for a 3/4 circle)"
                },
                "rotateDirection": {
                  "type": "string",
                  "enum": [
                    "clockwise",
                    "counterclockwise"
                  ],
                  "default": "clockwise",
                  "description": "按顺时针绘制或者逆时针绘制"
                },
                "border": {
                  "type": "object",
                  "properties": {
                    "radius": {
                      "oneOf": [
                        {
                          "type": "number"
                        },
                        {
                          "type": "array",
                          "items": {
                            "type": "number"
                          },
                          "minItems": 4,
                          "maxItems": 4
                        }
                      ],
                      "default": 0,
                      "description": "圆角，对玉玦弧段端点可能有效"
                    },
                    "type": {
                      "type": "string",
                      "enum": [
                        "solid",
                        "dashed",
                        "dotted"
                      ],
                      "default": "solid"
                    },
                    "width": {
                      "type": "number",
                      "default": 1
                    },
                    "color": {
                      "$ref": "commonChartDefinitions.json#/definitions/borderElementColorOption"
                    }
                  },
                  "required": [
                    "radius",
                    "type",
                    "width"
                  ]
                }
              },
              "required": [
                "innerRadiusRatio",
                "gapPercentage",
                "startAngle",
                "drawAngle",
                "rotateDirection",
                "border"
              ]
            }
          },
          "required": [
            "pie"
          ]
        },
        "legend": {
          "$ref": "commonChartDefinitions.json#/definitions/legendConfig"
        },
        "label": {
          "type": "object",
          "description": "标签配置",
          "properties": {
            "show": {
              "type": "boolean",
              "default": true,
              "description": "是否显示所有标签（总开关）"
            },
            "numberLabel": {
              "type": "object",
              "description": "玉玦图数值标签",
              "properties": {
                "show": {
                  "type": "boolean",
                  "default": true,
                  "description": "是否显示数值标签"
                },
                "positionChoice": {
                  "type": "string",
                  "enum": [
                    "inside-left",
                    "inside-right",
                    "outside"
                  ],
                  "default": "outside",
                  "description": "标签位置 (relative to the arc end)"
                },
                "fontFamily": {
                  "type": "string",
                  "default": "Misans 常规"
                },
                "fontSize": {
                  "type": "number",
                  "default": 12
                },
                "color": {
                  "$ref": "commonChartDefinitions.json#/definitions/simpleColor",
                  "default": {
                    "color": "#000000",
                    "opacity": 1
                  }
                },
                "suffix": {
                  "type": "string",
                  "default": "%"
                }
              },
              "required": [
                "show",
                "positionChoice",
                "fontFamily",
                "fontSize",
                "color",
                "suffix"
              ]
            },
            "highlight": {
              "type": "boolean",
              "default": false
            },
            "overlap": {
              "type": "boolean",
              "default": false
            }
          },
          "required": [
            "show",
            "numberLabel",
            "highlight",
            "overlap"
          ]
        },
        "axis": {
          "type": "object",
          "description": "坐标轴配置 (周向轴和径向轴)",
          "properties": {
            "show": {
              "type": "boolean",
              "default": false,
              "description": "是否显示坐标轴 (often false for Jade Jue aesthetic)"
            },
            "angleAxis": {
              "type": "array",
              "description": "周向轴（角度/值轴）配置数组",
              "items": {
                "type": "object",
                "description": "周向轴配置单元",
                "properties": {
                  "line": {
                    "type": "object",
                    "properties": {
                      "show": {
                        "type": "boolean",
                        "default": false
                      },
                      "width": {
                        "type": "number",
                        "default": 1
                      },
                      "color": {
                        "$ref": "commonChartDefinitions.json#/definitions/simpleColor"
                      }
                    },
                    "required": [
                      "show",
                      "width",
                      "color"
                    ]
                  },
                  "label": {
                    "type": "object",
                    "properties": {
                      "show": {
                        "type": "boolean",
                        "default": false
                      },
                      "direction": {
                        "type": "string",
                        "enum": [
                          "horizontal",
                          "circumference",
                          "radial"
                        ],
                        "default": "radial"
                      },
                      "fontFamily": {
                        "type": "string"
                      },
                      "fontSize": {
                        "type": "number"
                      },
                      "color": {
                        "$ref": "commonChartDefinitions.json#/definitions/simpleColor"
                      }
                    },
                    "required": [
                      "show",
                      "direction",
                      "fontFamily",
                      "fontSize",
                      "color"
                    ]
                  },
                  "grid": {
                    "type": "object",
                    "properties": {
                      "show": {
                        "type": "boolean",
                        "default": true
                      },
                      "width": {
                        "type": "number",
                        "default": 1
                      },
                      "color": {
                        "$ref": "commonChartDefinitions.json#/definitions/simpleColor",
                        "default": {
                          "color": "#eeeeee",
                          "opacity": 1
                        }
                      },
                      "type": {
                        "type": "string",
                        "enum": [
                          "solid",
                          "dashed",
                          "dotted"
                        ],
                        "default": "solid"
                      }
                    },
                    "required": [
                      "show",
                      "width",
                      "color",
                      "type"
                    ]
                  },
                  "position": {
                    "type": "string",
                    "enum": [
                      "inside",
                      "outside"
                    ],
                    "default": "inside"
                  },
                  "type": {
                    "type": "string",
                    "enum": [
                      "value"
                    ],
                    "default": "value",
                    "description": "周向轴类型 (value representing progress/percentage)"
                  },
                  "stepOfLabel": {
                    "oneOf": [
                      {
                        "type": "number"
                      },
                      {
                        "type": "string",
                        "enum": [
                          "auto"
                        ]
                      }
                    ],
                    "default": "auto"
                  },
                  "range": {
                    "type": "array",
                    "items": {
                      "type": "number"
                    },
                    "default": [],
                    "description": "周向轴范围"
                  }
                },
                "required": [
                  "line",
                  "label",
                  "grid",
                  "position",
                  "type",
                  "stepOfLabel",
                  "range"
                ]
              },
              "minItems": 1,
              "maxItems": 1
            },
            "radiusAxis": {
              "type": "array",
              "description": "径向轴（分类轴）配置数组",
              "items": {
                "type": "object",
                "description": "径向轴配置单元",
                "properties": {
                  "line": {
                    "type": "object",
                    "properties": {
                      "show": {
                        "type": "boolean",
                        "default": false
                      },
                      "width": {
                        "type": "number",
                        "default": 1
                      },
                      "color": {
                        "$ref": "commonChartDefinitions.json#/definitions/simpleColor"
                      }
                    },
                    "required": [
                      "show",
                      "width",
                      "color"
                    ]
                  },
                  "label": {
                    "type": "object",
                    "properties": {
                      "show": {
                        "type": "boolean",
                        "default": true
                      },
                      "fontFamily": {
                        "type": "string",
                        "default": "Misans 常规"
                      },
                      "fontSize": {
                        "type": "number",
                        "default": 12
                      },
                      "color": {
                        "$ref": "commonChartDefinitions.json#/definitions/simpleColor",
                        "default": {
                          "color": "#000000",
                          "opacity": 1
                        }
                      },
                      "suffix": {
                        "type": "string",
                        "default": ""
                      }
                    },
                    "required": [
                      "show",
                      "fontFamily",
                      "fontSize",
                      "color",
                      "suffix"
                    ]
                  },
                  "grid": {
                    "type": "object",
                    "properties": {
                      "show": {
                        "type": "boolean",
                        "default": false
                      },
                      "width": {
                        "type": "number",
                        "default": 1
                      },
                      "color": {
                        "$ref": "commonChartDefinitions.json#/definitions/simpleColor",
                        "default": {
                          "color": "#cccccc",
                          "opacity": 1
                        }
                      },
                      "type": {
                        "type": "string",
                        "enum": [
                          "solid",
                          "dashed",
                          "dotted"
                        ],
                        "default": "solid"
                      }
                    },
                    "required": [
                      "show",
                      "width",
                      "color",
                      "type"
                    ]
                  },
                  "position": {
                    "type": "string",
                    "enum": [
                      "inside",
                      "outside"
                    ],
                    "default": "outside"
                  },
                  "type": {
                    "type": "string",
                    "enum": [
                      "category"
                    ],
                    "default": "category",
                    "description": "径向轴类型 (categories for different Jue rings)"
                  }
                },
                "required": [
                  "line",
                  "label",
                  "grid",
                  "position",
                  "type"
                ]
              },
              "minItems": 1,
              "maxItems": 1
            }
          },
          "required": [
            "show",
            "angleAxis",
            "radiusAxis"
          ]
        },
        "numberFormat": {
          "$ref": "commonChartDefinitions.json#/definitions/numberFormatConfig"
        },
        "animation": {
          "$ref": "commonChartDefinitions.json#/definitions/animationConfig"
        },
        "tooltip": {
          "$ref": "commonChartDefinitions.json#/definitions/tooltipConfig"
        },
        "padding": {
          "$ref": "commonChartDefinitions.json#/definitions/paddingConfig"
        }
      },
      "required": [
        "type",
        "title",
        "background",
        "map",
        "fill",
        "display",
        "legend",
        "label",
        "axis",
        "numberFormat",
        "animation",
        "tooltip",
        "padding"
      ]
    }
  },
  "required": [
    "data",
    "pipe",
    "props"
  ]
}